---
import BaseLayout from './BaseLayout.astro';

interface Question {
  id: number;
  question: string;
  options: string[];
  answer: number;
  explanation: string;
  keyConcept?: string;
  examTip?: string;
  testedIn?: string[];
}

interface Props {
  title: string;
  description: string;
  subject: string;
  subjectName: string;
  topic: string;
  topicName: string;
  difficulty: 'Basic' | 'Intermediate' | 'Advanced' | 'Exam-Level';
  targetExams: string[];
  questions: Question[];
  updatedDate: string;
  ogImage?: string;
}

const {
  title,
  description,
  subject,
  subjectName,
  topic,
  topicName,
  difficulty,
  targetExams,
  questions,
  updatedDate,
  ogImage,
} = Astro.props;

const totalQuestions = questions.length;
const difficultyColors = {
  'Basic': 'bg-green-50 text-green-700 border-green-200',
  'Intermediate': 'bg-blue-50 text-blue-700 border-blue-200',
  'Advanced': 'bg-orange-50 text-orange-700 border-orange-200',
  'Exam-Level': 'bg-red-50 text-red-700 border-red-200',
};
---

<BaseLayout title={title} description={description} ogImage={ogImage}>
  <!-- Breadcrumb -->
  <div class="bg-slate-50 border-b border-slate-200">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
      <nav class="flex items-center space-x-2 text-sm text-slate-600">
        <a href="/" class="hover:text-teal-600">Home</a>
        <span>/</span>
        <a href="/subjects" class="hover:text-teal-600">Subjects</a>
        <span>/</span>
        <a href={`/subjects/${subject}`} class="hover:text-teal-600">{subjectName}</a>
        <span>/</span>
        <span class="text-slate-900 font-medium truncate">{topicName}</span>
      </nav>
    </div>
  </div>

  <!-- Header -->
  <div class="bg-gradient-to-br from-slate-900 to-slate-800 text-white py-12">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-4">
        <a href={`/subjects/${subject}`} class="inline-block text-teal-300 hover:text-teal-200 font-medium text-sm mb-2">← {subjectName}</a>
      </div>
      <h1 class="text-3xl md:text-4xl font-bold mb-3">{title}</h1>
      <p class="text-slate-300 text-lg mb-6">{description}</p>

      <!-- Stats -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="bg-white/10 backdrop-blur rounded-lg p-4">
          <div class="text-2xl font-bold text-teal-300">{totalQuestions}</div>
          <div class="text-sm text-slate-300">Questions</div>
        </div>
        <div class="bg-white/10 backdrop-blur rounded-lg p-4">
          <div class="text-2xl font-bold text-teal-300">{difficulty}</div>
          <div class="text-sm text-slate-300">Difficulty</div>
        </div>
        <div class="bg-white/10 backdrop-blur rounded-lg p-4">
          <div class="text-2xl font-bold text-teal-300">{targetExams.length}</div>
          <div class="text-sm text-slate-300">Exams Covered</div>
        </div>
        <div class="bg-white/10 backdrop-blur rounded-lg p-4">
          <div class="text-2xl font-bold text-teal-300">{Math.ceil(totalQuestions * 1.5)}</div>
          <div class="text-sm text-slate-300">Min Time</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Content -->
  <article class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Metadata -->
    <div class="flex flex-wrap gap-3 mb-8 pb-8 border-b border-slate-200">
      <span class={`inline-block px-3 py-1 rounded-full border text-xs font-medium ${difficultyColors[difficulty]}`}>
        {difficulty}
      </span>
      {targetExams.map((exam) => (
        <span class="inline-block px-3 py-1 bg-teal-50 text-teal-700 rounded-full border border-teal-200 text-xs font-medium">
          {exam}
        </span>
      ))}
      <div class="ml-auto text-sm text-slate-500">
        Last updated: {new Date(updatedDate).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
      </div>
    </div>

    <!-- Interactive MCQs Component -->
    <interactive-mcq-widget questions={JSON.stringify(questions)} />

    <!-- Additional Content -->
    <div class="mt-12 p-6 bg-blue-50 border border-blue-200 rounded-lg">
      <h3 class="font-bold text-blue-900 mb-3">💡 How to Use These MCQs</h3>
      <ul class="text-sm text-blue-800 space-y-2">
        <li><strong>Self-Assessment:</strong> Test your current knowledge level before studying.</li>
        <li><strong>Learning Aid:</strong> Read explanations carefully to understand concepts, not just memorize answers.</li>
        <li><strong>Revision Tool:</strong> Review these questions periodically before exams.</li>
        <li><strong>Time Management:</strong> Practice answering within time limits to improve speed.</li>
      </ul>
    </div>

    <!-- Related Content -->
    <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="p-4 border border-slate-200 rounded-lg hover:shadow-md transition">
        <h4 class="font-semibold text-slate-900 mb-2">📚 Study Guides</h4>
        <p class="text-sm text-slate-600 mb-3">Deep dive into {topicName} concepts</p>
        <a href={`/guides/${subject}`} class="text-teal-600 font-medium text-sm hover:text-teal-700">Explore →</a>
      </div>
      <div class="p-4 border border-slate-200 rounded-lg hover:shadow-md transition">
        <h4 class="font-semibold text-slate-900 mb-2">🎯 More Practice</h4>
        <p class="text-sm text-slate-600 mb-3">Find more MCQs in {subjectName}</p>
        <a href={`/mcqs/${subject}`} class="text-teal-600 font-medium text-sm hover:text-teal-700">Browse →</a>
      </div>
      <div class="p-4 border border-slate-200 rounded-lg hover:shadow-md transition">
        <h4 class="font-semibold text-slate-900 mb-2">📖 Subject Hub</h4>
        <p class="text-sm text-slate-600 mb-3">Full curriculum for {subjectName}</p>
        <a href={`/subjects/${subject}`} class="text-teal-600 font-medium text-sm hover:text-teal-700">View →</a>
      </div>
    </div>
  </article>

  <!-- JSON-LD Quiz Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Quiz",
    "name": title,
    "description": description,
    "numberOfQuestions": totalQuestions,
    "quizItem": questions.map(q => ({
      "@type": "Question",
      "name": q.question,
      "text": q.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": q.options[q.answer],
        "explanation": q.explanation
      },
      "suggestedAnswer": q.options.map((opt, idx) => ({
        "@type": "Answer",
        "text": opt
      }))
    }))
  })} />
</BaseLayout>

<style>
  /* Placeholder for interactive widget styling */
  interactive-mcq-widget {
    display: block;
  }
</style>
