---
import BaseLayout from './BaseLayout.astro';
import InteractiveMCQ from '../components/InteractiveMCQ.astro';

interface Question {
  id: number;
  question: string;
  options: string[];
  answer: number;
  explanation: string;
  keyConcept?: string;
  examTip?: string;
  testedIn?: string[];
}

interface PartInfo {
  subject: string;
  topic: string;
  topicName: string;
  count: number;
  part: number;
}

interface RelatedSet {
  subject: string;
  topic: string;
  topicName: string;
  count: number;
  difficulty?: string;
}

interface Props {
  title: string;
  description: string;
  subject: string;
  subjectName: string;
  topic: string;
  topicName: string;
  difficulty: 'Basic' | 'Intermediate' | 'Advanced' | 'Exam-Level';
  targetExams: string[];
  questions: Question[];
  updatedDate: string;
  seriesParts?: PartInfo[];
  prevPart?: PartInfo | null;
  nextPart?: PartInfo | null;
  relatedSets?: RelatedSet[];
  ogImage?: string;
}

const {
  title,
  description,
  subject,
  subjectName,
  topic,
  topicName,
  difficulty,
  targetExams,
  questions,
  updatedDate,
  seriesParts = [],
  prevPart = null,
  nextPart = null,
  relatedSets = [],
  ogImage,
} = Astro.props;

const totalQuestions = questions.length;
const difficultyColors = {
  'Basic': 'bg-emerald-50 text-emerald-800 border-emerald-200',
  'Intermediate': 'bg-sky-50 text-sky-800 border-sky-200',
  'Advanced': 'bg-amber-50 text-amber-800 border-amber-200',
  'Exam-Level': 'bg-rose-50 text-rose-800 border-rose-200',
};

// Sequential URLs for series navigation and search crawler hints
const canonicalUrl = `https://examhub.pk/mcqs/${subject}/${topic}`;
const prevUrl = prevPart ? `https://examhub.pk/mcqs/${prevPart.subject}/${prevPart.topic}` : undefined;
const nextUrl = nextPart ? `https://examhub.pk/mcqs/${nextPart.subject}/${nextPart.topic}` : undefined;
const fallbackNextSet = relatedSets && relatedSets.length > 0 ? relatedSets[0] : null;
---

<BaseLayout
  title={title}
  description={description}
  ogImage={ogImage}
  canonical={canonicalUrl}
  prevUrl={prevUrl}
  nextUrl={nextUrl}
>
  <!-- Breadcrumb -->
  <div class="bg-slate-50 border-b border-slate-200/80">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
      <nav class="flex items-center space-x-2 text-sm text-slate-600">
        <a href="/" class="hover:text-teal-600 font-medium transition-colors">Home</a>
        <span class="text-slate-400">/</span>
        <a href="/subjects" class="hover:text-teal-600 font-medium transition-colors">Subjects</a>
        <span class="text-slate-400">/</span>
        <a href={`/subjects/${subject}`} class="hover:text-teal-600 font-medium transition-colors truncate">{subjectName}</a>
        <span class="text-slate-400">/</span>
        <span class="text-slate-900 font-semibold truncate">{topicName}</span>
      </nav>
    </div>
  </div>

  <!-- Header Banner -->
  <header class="bg-gradient-to-br from-slate-950 via-slate-900 to-teal-950 text-white py-10 md:py-14 relative overflow-hidden">
    <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#0d9488_1px,transparent_1px)] [background-size:16px_16px]"></div>
    
    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-3">
        <a
          href={`/subjects/${subject}`}
          class="inline-flex items-center gap-1.5 text-teal-300 hover:text-teal-200 font-semibold text-xs uppercase tracking-wider bg-white/10 px-3 py-1 rounded-full backdrop-blur-xs transition"
        >
          <span>←</span>
          <span>{subjectName} Hub</span>
        </a>
      </div>

      <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold tracking-tight mb-3">
        {title}
      </h1>
      <p class="text-slate-300 text-sm sm:text-base max-w-3xl mb-6 leading-relaxed">
        {description}
      </p>

      <!-- Key Metadata Pills -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4 pt-4 border-t border-slate-800">
        <div class="bg-slate-800/70 border border-slate-700/70 rounded-xl p-3 backdrop-blur-xs">
          <div class="text-xs text-slate-400 font-medium">Questions</div>
          <div class="text-xl sm:text-2xl font-black text-teal-300 mt-0.5">{totalQuestions}</div>
        </div>
        <div class="bg-slate-800/70 border border-slate-700/70 rounded-xl p-3 backdrop-blur-xs">
          <div class="text-xs text-slate-400 font-medium">Difficulty Level</div>
          <div class="text-base sm:text-lg font-bold text-teal-300 mt-0.5">{difficulty}</div>
        </div>
        <div class="bg-slate-800/70 border border-slate-700/70 rounded-xl p-3 backdrop-blur-xs">
          <div class="text-xs text-slate-400 font-medium">Target Exams</div>
          <div class="text-sm font-bold text-teal-300 mt-0.5 truncate">
            {targetExams.slice(0, 3).join(', ')}{targetExams.length > 3 ? '...' : ''}
          </div>
        </div>
        <div class="bg-slate-800/70 border border-slate-700/70 rounded-xl p-3 backdrop-blur-xs">
          <div class="text-xs text-slate-400 font-medium">Estimated Time</div>
          <div class="text-xl sm:text-2xl font-black text-teal-300 mt-0.5">
            {Math.ceil(totalQuestions * 1.2)} <span class="text-xs font-normal text-slate-400">mins</span>
          </div>
        </div>
      </div>

      <!-- Topic Series Navigation Pill Bar (Multi-Part Linking) -->
      {seriesParts && seriesParts.length > 1 && (
        <div class="mt-6 pt-5 border-t border-slate-800/80">
          <div class="flex items-center gap-2 mb-2.5 text-xs font-bold uppercase tracking-wider text-teal-300">
            <span>📚</span>
            <span>Module Parts in this Series ({seriesParts.length} Parts):</span>
          </div>
          <div class="flex flex-wrap gap-2">
            {seriesParts.map((p) => {
              const isCurrent = p.topic === topic;
              return isCurrent ? (
                <span
                  class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-black bg-teal-500 text-slate-950 shadow-sm"
                  aria-current="page"
                >
                  <span>✓</span>
                  <span>Part {p.part}</span>
                  <span class="text-[10px] font-semibold opacity-75">({p.count}Q)</span>
                </span>
              ) : (
                <a
                  href={`/mcqs/${p.subject}/${p.topic}`}
                  class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-bold bg-white/10 hover:bg-white/20 text-slate-200 hover:text-white transition"
                  title={`Go to Part ${p.part}`}
                >
                  <span>Part {p.part}</span>
                  <span class="text-[10px] opacity-70">({p.count}Q)</span>
                </a>
              );
            })}
          </div>
        </div>
      )}
    </div>
  </header>

  <!-- Main Question Practice Content -->
  <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-10">
    
    <!-- Badges Row -->
    <div class="flex flex-wrap items-center justify-between gap-3 mb-6 pb-4 border-b border-slate-200">
      <div class="flex flex-wrap items-center gap-2">
        <span class={`inline-block px-3 py-1 rounded-full border text-xs font-bold ${difficultyColors[difficulty]}`}>
          {difficulty}
        </span>
        {targetExams.map((exam) => (
          <span class="inline-block px-2.5 py-0.5 bg-teal-50 text-teal-800 rounded-md border border-teal-200/80 text-xs font-semibold">
            {exam}
          </span>
        ))}
      </div>
      <div class="text-xs text-slate-500 font-medium">
        Verified for Commission Syllabus • {new Date(updatedDate).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
      </div>
    </div>

    <!-- Interactive MCQs Engine -->
    <InteractiveMCQ
      questions={questions}
      subjectTitle={subjectName}
      topicTitle={topicName}
      setId={`${subject}/${topic}`}
    />

    <!-- Sequential Series Pager & Continue Practice -->
    {(prevPart || nextPart || fallbackNextSet) && (
      <div class="mt-10 pt-6 border-t border-slate-200">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {prevPart ? (
            <a
              href={`/mcqs/${prevPart.subject}/${prevPart.topic}`}
              class="p-4 rounded-2xl border border-slate-200 bg-white hover:border-teal-500 hover:bg-teal-50/20 transition flex items-center gap-3.5 group shadow-xs"
            >
              <div class="w-10 h-10 rounded-xl bg-slate-100 group-hover:bg-teal-100 text-slate-600 group-hover:text-teal-700 flex items-center justify-center font-bold text-lg transition-colors flex-shrink-0">
                ←
              </div>
              <div class="min-w-0">
                <span class="text-2xs font-extrabold uppercase tracking-wider text-slate-500 block">Previous Module</span>
                <span class="text-sm font-bold text-slate-900 group-hover:text-teal-700 transition truncate block">
                  {prevPart.topicName}
                </span>
                <span class="text-xs text-slate-500">{prevPart.count} verified questions</span>
              </div>
            </a>
          ) : (
            <div class="hidden sm:block"></div>
          )}

          {nextPart ? (
            <a
              href={`/mcqs/${nextPart.subject}/${nextPart.topic}`}
              class="p-4 rounded-2xl border-2 border-teal-500 bg-gradient-to-br from-teal-500/10 to-teal-500/5 hover:bg-teal-500/20 transition flex items-center justify-between gap-3.5 group shadow-xs text-right"
            >
              <div class="min-w-0 flex-1">
                <span class="text-2xs font-black uppercase tracking-wider text-teal-800 block">Next Part in Series</span>
                <span class="text-sm font-black text-slate-900 group-hover:text-teal-900 transition truncate block">
                  {nextPart.topicName}
                </span>
                <span class="text-xs text-teal-700 font-semibold">{nextPart.count} verified questions</span>
              </div>
              <div class="w-10 h-10 rounded-xl bg-teal-600 text-white flex items-center justify-center font-bold text-lg group-hover:scale-105 transition-transform flex-shrink-0 shadow-xs">
                →
              </div>
            </a>
          ) : fallbackNextSet ? (
            <a
              href={`/mcqs/${fallbackNextSet.subject}/${fallbackNextSet.topic}`}
              class="p-4 rounded-2xl border border-slate-200 bg-white hover:border-teal-500 hover:bg-teal-50/20 transition flex items-center justify-between gap-3.5 group shadow-xs text-right"
            >
              <div class="min-w-0 flex-1">
                <span class="text-2xs font-extrabold uppercase tracking-wider text-slate-500 block">Next Subject Module</span>
                <span class="text-sm font-bold text-slate-900 group-hover:text-teal-700 transition truncate block">
                  {fallbackNextSet.topicName}
                </span>
                <span class="text-xs text-slate-500">{fallbackNextSet.count} questions</span>
              </div>
              <div class="w-10 h-10 rounded-xl bg-slate-100 group-hover:bg-teal-100 text-slate-600 group-hover:text-teal-700 flex items-center justify-center font-bold text-lg transition-colors flex-shrink-0">
                →
              </div>
            </a>
          ) : null}
        </div>
      </div>
    )}

    <!-- Pedagogical Guidance Box -->
    <section class="mt-8 p-6 bg-slate-50 border border-slate-200 rounded-2xl">
      <h3 class="font-bold text-slate-900 text-sm mb-2 flex items-center gap-2">
        <span class="text-teal-600">💡</span>
        <span>Examiner's Advisory for {subjectName}</span>
      </h3>
      <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-3">
        In competitive commission exams (FPSC, PPSC, KPPSC, SPSC, CSS, PMS), questions are frequently phrased with distractor options designed to catch rote learners. Whenever you answer an MCQ, read the <strong>Detailed Academic Explanation</strong> and <strong>Conceptual Anchor</strong> to understand why the remaining options are incorrect.
      </p>
      <div class="flex flex-wrap gap-2 pt-2 border-t border-slate-200/80">
        <a href={`/subjects/${subject}`} class="text-xs font-bold text-teal-700 hover:text-teal-900">
          View full {subjectName} curriculum →
        </a>
      </div>
    </section>

    <!-- More Sets in this Subject -->
    {relatedSets.length > 0 && (
      <section class="mt-12">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-lg sm:text-xl font-bold text-slate-900">
            More Modules in {subjectName}
          </h2>
          <a href={`/subjects/${subject}`} class="text-xs font-bold text-teal-700 hover:text-teal-900">
            View All →
          </a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
          {relatedSets.slice(0, 6).map((set) => (
            <a
              href={`/mcqs/${set.subject}/${set.topic}`}
              class="flex flex-col justify-between p-4 bg-white border border-slate-200 rounded-xl hover:border-teal-500 hover:shadow-sm hover:bg-teal-50/20 transition-all group"
            >
              <div>
                <span class="font-bold text-sm text-slate-800 group-hover:text-teal-700 transition-colors line-clamp-2">
                  {set.topicName}
                </span>
              </div>
              <div class="flex items-center justify-between mt-3 pt-3 border-t border-slate-100 text-xs">
                <span class="font-bold text-teal-800 bg-teal-50 px-2 py-0.5 rounded">
                  {set.count} MCQs
                </span>
                <span class="text-teal-600 font-semibold group-hover:translate-x-1 transition-transform">
                  Practice →
                </span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Navigation Hub Cards -->
    <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="p-5 bg-white border border-slate-200 rounded-xl shadow-2xs">
        <div class="text-xl mb-2">📚</div>
        <h4 class="font-bold text-slate-900 text-sm mb-1">Study Guides</h4>
        <p class="text-xs text-slate-500 mb-3">Topic summaries and syllabus breakdown</p>
        <a href="/guides" class="text-teal-700 font-bold text-xs hover:text-teal-900">Explore Guides →</a>
      </div>
      <div class="p-5 bg-white border border-slate-200 rounded-xl shadow-2xs">
        <div class="text-xl mb-2">🎯</div>
        <h4 class="font-bold text-slate-900 text-sm mb-1">Complete Library</h4>
        <p class="text-xs text-slate-500 mb-3">Search through 78,000+ verified MCQs</p>
        <a href="/mcqs" class="text-teal-700 font-bold text-xs hover:text-teal-900">Browse Library →</a>
      </div>
      <div class="p-5 bg-white border border-slate-200 rounded-xl shadow-2xs">
        <div class="text-xl mb-2">📱</div>
        <h4 class="font-bold text-slate-900 text-sm mb-1">Mobile App</h4>
        <p class="text-xs text-slate-500 mb-3">Offline mock tests and instant bookmarks</p>
        <a
          href="https://play.google.com/store/apps/details?id=com.examhub.app"
          target="_blank"
          rel="noopener noreferrer"
          class="text-teal-700 font-bold text-xs hover:text-teal-900"
        >
          Get Mobile App →
        </a>
      </div>
    </div>
  </main>

  <!-- Google Practice Problems (Quiz) Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Quiz",
    "name": title,
    "description": description,
    "educationalLevel": difficulty,
    "about": {
      "@type": "Thing",
      "name": subjectName
    },
    "hasPart": questions.map(q => ({
      "@type": "Question",
      "eduQuestionType": "Multiple choice",
      "learningResourceType": "Practice problem",
      "text": q.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": q.options[q.answer] ?? '',
        ...(q.explanation ? {
          "comment": {
            "@type": "Comment",
            "text": q.explanation
          }
        } : {})
      },
      "suggestedAnswer": q.options
        .filter((_, idx) => idx !== q.answer)
        .map(opt => ({
          "@type": "Answer",
          "text": opt
        }))
    }))
  })} />

  <!-- BreadcrumbList Schema for Rich Results -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://examhub.pk"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Subjects",
        "item": "https://examhub.pk/subjects"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": subjectName,
        "item": `https://examhub.pk/subjects/${subject}`
      },
      {
        "@type": "ListItem",
        "position": 4,
        "name": topicName,
        "item": canonicalUrl
      }
    ]
  })} />
</BaseLayout>
