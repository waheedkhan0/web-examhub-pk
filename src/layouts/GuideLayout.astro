---
import BaseLayout from './BaseLayout.astro';
import { getCollection } from 'astro:content';

interface Props {
  title: string;
  description: string;
  author?: string;
  publishDate: string;
  updatedDate: string;
  readingTime?: string;
  category?: string;
  targetExams?: string[];
  tags?: string[];
  ogImage?: string;
}

const {
  title,
  description,
  author = 'ExamHub Academic Editorial Board',
  publishDate,
  updatedDate,
  readingTime = '10 min read',
  category,
  targetExams = [],
  tags = [],
  ogImage,
} = Astro.props;

const isBlog = Astro.url.pathname.startsWith('/blog');
const sectionTitle = isBlog ? 'Blog' : 'Guides';
const sectionHref = isBlog ? '/blog' : '/guides';

const formattedPublishDate = new Date(publishDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const formattedUpdatedDate = new Date(updatedDate || publishDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const toIsoDate = (d?: string | Date) => {
  if (!d) return undefined;
  const dateObj = new Date(d);
  return isNaN(dateObj.getTime()) ? undefined : dateObj.toISOString();
};

const authorName = author || 'ExamHub Academic Editorial Board';
const isOrgAuthor =
  authorName.toLowerCase().includes('editorial') ||
  authorName.toLowerCase().includes('board') ||
  authorName.toLowerCase().includes('team') ||
  authorName.toLowerCase().includes('desk');

const siteUrl = Astro.site ? Astro.site.origin : 'https://examhub.pk';
const pageUrl = new URL(Astro.url.pathname, siteUrl).href;

const resolvedImage = ogImage
  ? (ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage.startsWith('/') ? '' : '/'}${ogImage}`)
  : `${siteUrl}/og-image.png`;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': isBlog ? 'BlogPosting' : 'Article',
  'headline': title,
  'description': description,
  'image': [resolvedImage],
  'datePublished': toIsoDate(publishDate) || publishDate,
  'dateModified': toIsoDate(updatedDate) || toIsoDate(publishDate) || publishDate,
  'author': {
    '@type': isOrgAuthor ? 'Organization' : 'Person',
    'name': authorName,
  },
  'publisher': {
    '@type': 'Organization',
    'name': 'ExamHub.pk',
    'logo': {
      '@type': 'ImageObject',
      'url': `${siteUrl}/logo.png`,
    },
  },
  'mainEntityOfPage': {
    '@type': 'WebPage',
    '@id': pageUrl,
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    {
      '@type': 'ListItem',
      'position': 1,
      'name': 'Home',
      'item': siteUrl,
    },
    {
      '@type': 'ListItem',
      'position': 2,
      'name': sectionTitle,
      'item': `${siteUrl}${sectionHref}`,
    },
    {
      '@type': 'ListItem',
      'position': 3,
      'name': title,
      'item': pageUrl,
    },
  ],
};
---

<BaseLayout title={title} description={description} ogImage={ogImage}>
  <!-- Breadcrumb Navigation -->
  <div class="bg-slate-50 border-b border-slate-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
      <nav class="flex items-center space-x-2 text-sm text-slate-600">
        <a href="/" class="hover:text-teal-600">Home</a>
        <span>/</span>
        <a href={sectionHref} class="hover:text-teal-600">{sectionTitle}</a>
        <span>/</span>
        <span class="text-slate-900 font-medium truncate">{title}</span>
      </nav>
    </div>
  </div>

  <!-- Article Header -->
  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <header class="mb-8">
      <h1 class="text-3xl md:text-4xl font-bold text-slate-900 mb-4 leading-tight">{title}</h1>
      <p class="text-lg text-slate-600 mb-6">{description}</p>

      <!-- Article Metadata -->
      <div class="flex flex-wrap items-center gap-6 text-sm text-slate-600 border-b border-slate-200 pb-6">
        <div class="flex items-center space-x-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>{readingTime}</span>
        </div>
        <div class="flex items-center space-x-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <time datetime={publishDate}>{formattedPublishDate}</time>
        </div>
        {updatedDate && updatedDate !== publishDate && (
          <div class="flex items-center space-x-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
            <span>Updated {formattedUpdatedDate}</span>
          </div>
        )}
      </div>

      <!-- Author & Category -->
      <div class="flex flex-wrap items-center gap-4 mt-6">
        {author && (
          <div class="flex items-center space-x-2">
            <div class="w-10 h-10 bg-teal-100 rounded-full flex items-center justify-center">
              <span class="text-teal-700 font-bold text-sm">{author.charAt(0)}</span>
            </div>
            <div>
              <p class="font-medium text-slate-900">{author}</p>
              <p class="text-xs text-slate-500">Educational Content</p>
            </div>
          </div>
        )}
      </div>

      <!-- Tags & Target Exams -->
      <div class="flex flex-wrap gap-3 mt-6">
        {targetExams.map((exam) => (
          <span class="inline-block px-3 py-1 bg-teal-50 text-teal-700 text-xs font-medium rounded-full border border-teal-200">
            {exam}
          </span>
        ))}
        {tags.map((tag) => (
          <span class="inline-block px-3 py-1 bg-slate-100 text-slate-700 text-xs font-medium rounded-full">
            {tag}
          </span>
        ))}
      </div>
    </header>

    <!-- Article Content -->
    <div class="prose prose-lg max-w-none mb-12 text-slate-700 leading-relaxed">
      <slot />
    </div>

    <!-- Last Updated Notice -->
    <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 my-8">
      <p class="text-sm text-blue-900">
        <strong>Last updated:</strong> {formattedUpdatedDate} | This content is regularly reviewed and updated to maintain accuracy and relevance.
      </p>
    </div>

    <!-- Post Navigation / Related Content -->
    <div class="mt-12 border-t border-slate-200 pt-8">
      <h3 class="text-xl font-bold text-slate-900 mb-6">Recommended Further Reading</h3>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <a href="/guides" class="p-4 border border-slate-200 rounded-lg hover:border-teal-500 hover:bg-teal-50 transition">
          <h4 class="font-semibold text-slate-900 mb-2">More Guides</h4>
          <p class="text-sm text-slate-600">Explore our comprehensive study guides</p>
        </a>
        <a href="/mcqs" class="p-4 border border-slate-200 rounded-lg hover:border-teal-500 hover:bg-teal-50 transition">
          <h4 class="font-semibold text-slate-900 mb-2">Practice MCQs</h4>
          <p class="text-sm text-slate-600">Test your knowledge with quality questions</p>
        </a>
        <a href="/subjects" class="p-4 border border-slate-200 rounded-lg hover:border-teal-500 hover:bg-teal-50 transition">
          <h4 class="font-semibold text-slate-900 mb-2">Subject Hubs</h4>
          <p class="text-sm text-slate-600">Browse topics by subject area</p>
        </a>
      </div>
    </div>
  </article>

  <!-- Structured Data: Article & Breadcrumbs -->
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</BaseLayout>
