---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact Us | ExamHub.pk"
  description="Get in touch with the ExamHub.pk team. We'd love to hear from you!"
>
  <div class="bg-gradient-to-br from-slate-900 to-slate-800 text-white py-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Contact Us</h1>
      <p class="text-xl text-slate-300">
        Have questions? We're here to help!
      </p>
    </div>
  </div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
      <!-- Contact Form -->
      <div>
        <h2 class="text-2xl font-bold text-slate-900 mb-6">Send us a Message</h2>
        <form class="space-y-4" name="contact" method="POST" netlify>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Name</label>
            <input type="text" name="name" required class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-teal-500 focus:border-transparent" />
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Email</label>
            <input type="email" name="email" required class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-teal-500 focus:border-transparent" />
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Subject</label>
            <input type="text" name="subject" required class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-teal-500 focus:border-transparent" />
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Message</label>
            <textarea name="message" rows="5" required class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-teal-500 focus:border-transparent"></textarea>
          </div>
          <button type="submit" class="btn btn-primary w-full">Send Message</button>
        </form>
      </div>

      <!-- Contact Info -->
      <div>
        <h2 class="text-2xl font-bold text-slate-900 mb-6">Get in Touch</h2>
        
        <div class="space-y-6">
          <div class="card">
            <h3 class="font-bold text-slate-900 mb-2">📧 Email</h3>
            <p class="text-slate-600">
              <a href="mailto:support@examhub.pk" class="text-teal-600 hover:text-teal-700">support@examhub.pk</a>
            </p>
          </div>

          <div class="card">
            <h3 class="font-bold text-slate-900 mb-2">🕐 Response Time</h3>
            <p class="text-slate-600">
              We typically respond to all inquiries within 24 hours during business days.
            </p>
          </div>

          <div class="card">
            <h3 class="font-bold text-slate-900 mb-2">💬 Feedback</h3>
            <p class="text-slate-600">
              Your feedback helps us improve. Whether it's a suggestion, correction, or question about our content, we'd love to hear it!
            </p>
          </div>

          <div class="card">
            <h3 class="font-bold text-slate-900 mb-2">❓ FAQ</h3>
            <p class="text-slate-600">
              Check our <a href="#" class="text-teal-600 hover:text-teal-700">FAQ section</a> for common questions about using ExamHub.pk.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
