---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { iconFor } from '../lib/icons';

// Get featured content
const guides = await getCollection('guides');
const blog = await getCollection('blog');
const subjects = await getCollection('subjects');
const exams = await getCollection('exams');
const mcqSets = await getCollection('mcqs');

const featuredGuides = guides.filter(g => g.data.featured).slice(0, 3);
const latestBlog = blog.sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()).slice(0, 3);

// Show the subjects with the most practice questions first, so the six cards on
// the homepage are the ones a candidate can actually study today.
const questionsBySubject = new Map<string, number>();
for (const set of mcqSets) {
  questionsBySubject.set(set.data.subject, (questionsBySubject.get(set.data.subject) ?? 0) + set.data.questions.length);
}
const allSubjects = [...subjects]
  .sort((a, b) => (questionsBySubject.get(b.slug) ?? 0) - (questionsBySubject.get(a.slug) ?? 0))
  .slice(0, 6);

// Counts come from the content itself, so these can never drift out of date.
const totalQuestions = mcqSets.reduce((sum, m) => sum + m.data.questions.length, 0);
const totalTopics = mcqSets.length;
const totalPages = guides.length + blog.length + subjects.length + exams.length + mcqSets.length;

const examOrder = [
  'fpsc-computer-operator',
  'fpsc-fia-superintendent',
  'kppsc-pms-officer',
  'fpsc-junior-scientific-officer',
  'kppsc-research-officer-agriculture',
  'kppsc-asi-police',
  'fpsc-senior-elementary-teacher',
  'fpsc-electrical-engineer',
  'fpsc-assistant-director-legal',
  'kppsc-assistant-director-plant-protection',
  'fia',
  'fpsc-lecturer',
  'civil-engineer',
  'css',
];
const popularExams = examOrder
  .map((slug) => exams.find((e) => e.slug === slug))
  .filter(Boolean)
  .concat(exams.filter((e) => !examOrder.includes(e.slug)))
  .slice(0, 6);
---

<BaseLayout title="ExamHub.pk - Pakistani Competitive Exam Preparation" description="Prepare for CSS, PMS, PPSC, FPSC, NTS and other Pakistani competitive exams with quality MCQs, guides, and resources.">
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 text-white py-20">
    <div class="absolute inset-0 overflow-hidden">
      <div class="absolute top-0 left-1/4 w-96 h-96 bg-teal-500/10 rounded-full blur-3xl"></div>
      <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-blue-500/10 rounded-full blur-3xl"></div>
    </div>
    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl md:text-6xl font-bold mb-6 leading-tight">
        Master Pakistani <span class="text-gradient">Competitive Exams & Jobs</span>
      </h1>
      <p class="text-xl md:text-2xl text-slate-300 mb-8 max-w-3xl mx-auto">
        High-quality MCQs, comprehensive guides, and expert resources for CSS, PMS, FPSC, KPPSC, FIA, Lecturers, Medical Officers, Civil Engineers, and more — every question with a worked explanation.
      </p>
      <div class="flex flex-wrap gap-4 justify-center mb-12">
        <a href="/practice" class="btn btn-primary text-lg inline-flex items-center gap-2">
          <span>⚡ Take Syllabus Mock Tests</span>
        </a>
        <a href="/jobs" class="btn bg-white/10 hover:bg-white/20 text-white text-lg font-semibold px-6 py-3 rounded-lg border border-white/20 transition">
          Browse Job Posts (BS-16/17)
        </a>
        <a href="/exams" class="btn bg-white/10 hover:bg-white/20 text-white text-lg font-semibold px-6 py-3 rounded-lg border border-white/20 transition">Explore Exams</a>
        <a href="/mcqs" class="btn btn-secondary text-lg">Subject MCQs</a>
      </div>

      <!-- Stats -->
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mt-12">
        <div class="bg-white/10 backdrop-blur rounded-lg p-6">
          <div class="text-4xl font-bold text-teal-300">{totalPages}</div>
          <div class="text-sm text-slate-300 mt-2">Published Pages</div>
        </div>
        <div class="bg-white/10 backdrop-blur rounded-lg p-6">
          <div class="text-4xl font-bold text-teal-300">{totalQuestions}</div>
          <div class="text-sm text-slate-300 mt-2">MCQs with Explanations</div>
        </div>
        <div class="bg-white/10 backdrop-blur rounded-lg p-6">
          <div class="text-4xl font-bold text-teal-300">{subjects.length}</div>
          <div class="text-sm text-slate-300 mt-2">Subjects ({totalTopics} Topic Sets)</div>
        </div>
        <div class="bg-white/10 backdrop-blur rounded-lg p-6">
          <div class="text-4xl font-bold text-teal-300">{exams.length}</div>
          <div class="text-sm text-slate-300 mt-2">Exam Guides</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Exams -->
  <section class="py-16 bg-slate-50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-slate-900 mb-4 text-center">Popular Exams</h2>
      <p class="text-center text-slate-600 mb-12 max-w-2xl mx-auto">Comprehensive preparation materials for Pakistan's most competitive civil service and professional exams</p>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {popularExams.map(exam => (
          <a href={`/exams/${exam.slug}`} class="card-hover group">
            <div class="flex items-start justify-between mb-3">
              <div>
                <h3 class="text-xl font-bold text-slate-900 group-hover:text-teal-600">{exam.data.title}</h3>
                <p class="text-sm text-slate-600 mt-1">{exam.data.fullName}</p>
              </div>
              <div class="text-2xl">📚</div>
            </div>
            <p class="text-sm text-slate-600 line-clamp-2 mb-2">{exam.data.description}</p>
            <p class="text-sm text-teal-600 font-medium group-hover:translate-x-1 transition-transform">View Details →</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Subjects Grid -->
  <section class="py-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-slate-900 mb-4 text-center">Study by Subject</h2>
      <p class="text-center text-slate-600 mb-12 max-w-2xl mx-auto">Master each subject with organized MCQs, detailed explanations, and exam-focused content</p>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {allSubjects.map(subject => (
          <a href={`/subjects/${subject.slug}`} class="card-hover group">
            <div class="flex items-start justify-between mb-3">
              <div>
                <h3 class="text-lg font-bold text-slate-900 group-hover:text-teal-600">{subject.data.title}</h3>
                <p class="text-xs text-slate-500 mt-1 font-medium">Syllabus: {subject.data.syllabusWeightage}</p>
              </div>
              <div class="text-2xl">{iconFor(subject.data.icon)}</div>
            </div>
            <p class="text-sm text-slate-600 line-clamp-2 mb-3">{subject.data.description}</p>
            <p class="text-xs text-teal-600 font-medium">Explore Topic →</p>
          </a>
        ))}
      </div>

      <div class="text-center mt-8">
        <a href="/subjects" class="btn btn-primary">View All Subjects</a>
      </div>
    </div>
  </section>

  <!-- Featured Guides -->
  <section class="py-16 bg-slate-50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-slate-900 mb-4 text-center">Study Guides</h2>
      <p class="text-center text-slate-600 mb-12 max-w-2xl mx-auto">In-depth guides covering strategies, syllabus breakdown, and expert tips for each major exam</p>
      
      {featuredGuides.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
          {featuredGuides.map(guide => (
            <a href={`/guides/${guide.slug}`} class="card-hover group">
              <div class="mb-3">
                <span class="badge badge-primary">{guide.data.category}</span>
              </div>
              <h3 class="text-lg font-bold text-slate-900 group-hover:text-teal-600 mb-2 line-clamp-2">{guide.data.title}</h3>
              <p class="text-sm text-slate-600 line-clamp-2 mb-4">{guide.data.description}</p>
              <div class="flex items-center justify-between text-xs text-slate-500">
                <span>{guide.data.readingTime}</span>
                <span class="text-teal-600 font-medium group-hover:translate-x-1 transition-transform">Read →</span>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <p class="text-center text-slate-600 mb-8">Featured guides coming soon...</p>
      )}

      <div class="text-center">
        <a href="/guides" class="btn btn-primary">Browse All Guides</a>
      </div>
    </div>
  </section>

  <!-- Latest Blog Posts -->
  <section class="py-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-slate-900 mb-4 text-center">Latest Updates</h2>
      <p class="text-center text-slate-600 mb-12 max-w-2xl mx-auto">Stay informed with exam news, strategy updates, and trending topics</p>
      
      {latestBlog.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
          {latestBlog.map(post => (
            <a href={`/blog/${post.slug}`} class="card-hover group">
              <div class="mb-3 flex items-center justify-between">
                <span class="badge badge-primary">{post.data.category}</span>
                <span class="text-xs text-slate-500">{new Date(post.data.publishDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}</span>
              </div>
              <h3 class="text-lg font-bold text-slate-900 group-hover:text-teal-600 mb-2 line-clamp-2">{post.data.title}</h3>
              <p class="text-sm text-slate-600 line-clamp-2">{post.data.description}</p>
            </a>
          ))}
        </div>
      ) : (
        <p class="text-center text-slate-600 mb-8">Latest posts coming soon...</p>
      )}

      <div class="text-center">
        <a href="/blog" class="btn btn-primary">View All Posts</a>
      </div>
    </div>
  </section>

  <!-- Mobile App Download Showcase -->
  <section class="py-16 bg-gradient-to-br from-slate-900 via-slate-800 to-teal-950 text-white relative overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-7">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-teal-500/20 border border-teal-400/30 text-teal-300 text-xs font-semibold uppercase tracking-wider mb-4">
            <span>📱</span> Mobile Learning App
          </div>
          <h2 class="text-3xl md:text-4xl font-bold mb-4 tracking-tight leading-tight">
            Prepare On The Go with the <span class="text-teal-400">ExamHub App</span>
          </h2>
          <p class="text-lg text-slate-300 mb-6 leading-relaxed">
            Take over 11,000+ solved MCQs, timed mock tests, and subject past papers wherever you are. Bookmark tricky questions, track your score percentages, and practice offline.
          </p>
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 mb-8 text-sm">
            <div class="flex items-center gap-2 text-slate-200">
              <span class="text-teal-400 font-bold">✓</span> Free to Download
            </div>
            <div class="flex items-center gap-2 text-slate-200">
              <span class="text-teal-400 font-bold">✓</span> All Competitive Exams
            </div>
            <div class="flex items-center gap-2 text-slate-200">
              <span class="text-teal-400 font-bold">✓</span> Timed Quizzes
            </div>
            <div class="flex items-center gap-2 text-slate-200">
              <span class="text-teal-400 font-bold">✓</span> Detailed Explanations
            </div>
            <div class="flex items-center gap-2 text-slate-200">
              <span class="text-teal-400 font-bold">✓</span> Personal Bookmarks
            </div>
            <div class="flex items-center gap-2 text-slate-200">
              <span class="text-teal-400 font-bold">✓</span> Instant Score Reports
            </div>
          </div>
          <div class="flex flex-wrap items-center gap-4">
            <a
              href="https://play.google.com/store/apps/details?id=com.examhub.app"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-3 px-6 py-3 bg-teal-600 hover:bg-teal-500 text-white rounded-xl font-semibold transition shadow-lg shadow-teal-900/30 group"
            >
              <svg class="w-6 h-6 fill-current group-hover:scale-110 transition-transform" viewBox="0 0 24 24">
                <path d="M3.609 1.814L13.792 12 3.61 22.186a2.316 2.316 0 0 1-.22-.989V2.803c0-.36.08-.7.22-.989zm11.235 11.238l2.091 2.091-11.75 6.78 9.659-8.871zm0-2.104L5.185 2.077l11.75 6.78-2.091 2.091zm1.488 1.488l3.666 2.116c.866.5.866 1.319 0 1.82l-3.666 2.116-2.227-2.226 2.227-2.226z"/>
              </svg>
              <div class="text-left">
                <div class="text-[10px] uppercase tracking-wider text-teal-100 font-medium">Available on</div>
                <div class="text-base font-bold leading-tight">Google Play</div>
              </div>
            </a>
            <span class="text-xs text-slate-400">Android 6.0 and above</span>
          </div>
        </div>
        <div class="lg:col-span-5 flex justify-center">
          <div class="bg-gradient-to-b from-slate-800 to-slate-900 border border-slate-700 p-6 rounded-3xl shadow-2xl max-w-sm w-full text-center">
            <div class="w-16 h-16 bg-teal-600 rounded-2xl flex items-center justify-center mx-auto mb-4 text-3xl font-bold shadow-md">
              E
            </div>
            <h3 class="text-xl font-bold text-white mb-1">ExamHub: MCQs & Quizzes</h3>
            <p class="text-xs text-teal-400 font-medium mb-4">Official Competitive Exam Prep App</p>
            <div class="grid grid-cols-3 gap-2 bg-slate-800/80 p-3 rounded-xl border border-slate-700/60 text-xs mb-6">
              <div>
                <div class="font-bold text-white">11,000+</div>
                <div class="text-slate-400 text-[11px]">MCQs</div>
              </div>
              <div class="border-x border-slate-700">
                <div class="font-bold text-teal-300">300+</div>
                <div class="text-slate-400 text-[11px]">Topics</div>
              </div>
              <div>
                <div class="font-bold text-white">4.8 ★</div>
                <div class="text-slate-400 text-[11px]">Rating</div>
              </div>
            </div>
            <a
              href="https://play.google.com/store/apps/details?id=com.examhub.app"
              target="_blank"
              rel="noopener noreferrer"
              class="w-full inline-block py-2.5 px-4 bg-white hover:bg-slate-100 text-slate-900 rounded-lg text-sm font-bold transition"
            >
              Install from Play Store
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="bg-teal-600 text-white py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">Ready to Excel?</h2>
      <p class="text-lg text-teal-100 mb-8 max-w-2xl mx-auto">
        Join thousands of students using ExamHub.pk to prepare for competitive exams. Start with free practice today.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/mcqs" class="btn bg-white text-teal-600 hover:bg-slate-100 font-semibold">Start Practicing</a>
        <a href="/about" class="btn border-2 border-white text-white hover:bg-white/10">Learn More</a>
      </div>
    </div>
  </section>

  <!-- Structured Data: Schema markup -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://examhub.pk"
        }
      ]
    }
  </script>

  <!-- FAQPage Schema for Search Engines & LLMs -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is ExamHub.pk?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "ExamHub.pk is Pakistan's premier competitive examination preparation platform offering 78,000+ verified MCQs with worked academic explanations, past papers, official syllabus blueprints, and timed mock tests for FPSC, PPSC, KPPSC, SPSC, BPSC, CSS, PMS, and NTS."
          }
        },
        {
          "@type": "Question",
          "name": "Which Pakistani competitive exams are covered on ExamHub?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "ExamHub provides comprehensive preparation modules for Federal Public Service Commission (FPSC), Punjab Public Service Commission (PPSC), Khyber Pakhtunkhwa Public Service Commission (KPPSC), Sindh Public Service Commission (SPSC), Central Superior Services (CSS MPT & Written), Provincial Management Services (PMS), National Testing Service (NTS), and departmental screenings (FIA, Lecturers, Police, Engineering, and Medical Officers)."
          }
        },
        {
          "@type": "Question",
          "name": "Are the MCQs and answers verified?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, every question is vetted by the ExamHub Academic Editorial Board against official commission answer keys, standard textbooks, and past papers. Each MCQ includes distractor analysis, key conceptual anchors, and examiner advisories to explain why the correct choice is valid."
          }
        },
        {
          "@type": "Question",
          "name": "Can I take timed mock tests according to official commission syllabi?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, the ExamHub Syllabus Mock Test engine at https://examhub.pk/practice lets candidates take timed tests conforming strictly to the official mark distribution, time limits, and section weightings of FPSC and provincial commissions."
          }
        }
      ]
    }
  </script>
</BaseLayout>
