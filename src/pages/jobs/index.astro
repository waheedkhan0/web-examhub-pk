---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const allExams = await getCollection('exams');

// Filter exams and job posts
const jobSlugs = [
  'fia',
  'ministry-of-interior',
  'fpsc-lecturer',
  'associate-professor',
  'medical-officer',
  'charge-nurse',
  'civil-engineer',
  'fpsc',
  'kppsc',
  'ppsc',
  'spsc',
  'nts',
];

const jobs = allExams.filter(e => jobSlugs.includes(e.slug));

const categories = [
  { name: 'All Jobs & Posts', filter: 'all' },
  { name: 'FIA & Interior', filter: 'interior' },
  { name: 'Lecturers & Academia', filter: 'education' },
  { name: 'Healthcare & Nursing', filter: 'health' },
  { name: 'Engineering', filter: 'engineering' },
  { name: 'FPSC Federal', filter: 'fpsc' },
  { name: 'KPPSC Provincial', filter: 'kppsc' },
];

function getCategoryTag(slug: string) {
  if (slug === 'fia' || slug === 'ministry-of-interior') return 'interior';
  if (slug === 'fpsc-lecturer' || slug === 'associate-professor') return 'education';
  if (slug === 'medical-officer' || slug === 'charge-nurse') return 'health';
  if (slug === 'civil-engineer') return 'engineering';
  if (slug === 'fpsc') return 'fpsc';
  if (slug === 'kppsc') return 'kppsc';
  return 'general';
}
---

<BaseLayout
  title="Government Jobs & Posts Preparation | FPSC, KPPSC, FIA, Health & Engineering | ExamHub.pk"
  description="Comprehensive preparation guides, syllabus breakdown, past paper schemes, and MCQs for government job posts advertised by FPSC, KPPSC, Ministry of Interior, FIA, Health, and Engineering departments."
>
  <!-- Hero Section -->
  <div class="bg-gradient-to-br from-slate-900 via-slate-800 to-teal-950 text-white py-14">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-teal-500/20 border border-teal-400/30 text-teal-300 text-sm font-medium mb-4">
        <span>🇵🇰</span> Government Recruitment Tests (BS-16 to BS-19)
      </div>
      <h1 class="text-4xl md:text-5xl font-bold mb-4 tracking-tight">
        Federal & Provincial <span class="text-teal-400">Job Posts & Screening Tests</span>
      </h1>
      <p class="text-xl text-slate-300 max-w-3xl leading-relaxed">
        Complete syllabus breakdowns, test schemes, past paper patterns, and high-yield MCQs for posts advertised by FPSC, KPPSC, PPSC, and Federal Ministries.
      </p>

      <div class="flex flex-wrap gap-3 mt-8">
        <a href="#jobs-grid" class="btn btn-primary">Browse Advertised Posts</a>
        <a href="/mcqs" class="btn btn-secondary">Practice Subject MCQs</a>
      </div>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12" id="jobs-grid">
    <!-- Category Pills -->
    <div class="flex flex-wrap gap-2 mb-10 pb-4 border-b border-slate-200">
      {categories.map((c, idx) => (
        <button
          type="button"
          class={`filter-btn px-4 py-2 rounded-lg text-sm font-semibold transition cursor-pointer ${
            idx === 0
              ? 'bg-teal-600 text-white shadow-sm'
              : 'bg-slate-100 text-slate-700 hover:bg-slate-200'
          }`}
          data-filter={c.filter}
        >
          {c.name}
        </button>
      ))}
    </div>

    <!-- Jobs Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="job-cards-container">
      {jobs.map((job) => {
        const catTag = getCategoryTag(job.slug);
        return (
          <div
            class="job-card card-hover group flex flex-col justify-between border border-slate-200 rounded-xl p-6 bg-white hover:border-teal-500 transition-all shadow-sm hover:shadow-md"
            data-category={catTag}
          >
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="inline-block px-2.5 py-1 text-xs font-semibold uppercase tracking-wider rounded-md bg-teal-50 text-teal-700 border border-teal-200">
                  {job.data.conductingBody.split('(')[0].trim()}
                </span>
                <span class="text-xs text-slate-500 font-medium">{job.data.frequency.split(' ')[0]}</span>
              </div>

              <h2 class="text-xl font-bold text-slate-900 group-hover:text-teal-600 transition mb-2">
                <a href={`/exams/${job.slug}`}>
                  {job.data.title}
                </a>
              </h2>
              <p class="text-sm text-slate-500 font-medium mb-3 line-clamp-1">{job.data.fullName}</p>
              <p class="text-sm text-slate-600 mb-5 line-clamp-3 leading-relaxed">{job.data.description}</p>
            </div>

            <div>
              <div class="grid grid-cols-2 gap-2 text-xs mb-5 bg-slate-50 p-3 rounded-lg border border-slate-100">
                {job.data.keyStats.slice(0, 2).map((stat: any) => (
                  <div>
                    <div class="font-bold text-slate-900">{stat.value}</div>
                    <div class="text-slate-500 text-[11px] truncate">{stat.label}</div>
                  </div>
                ))}
              </div>

              <div class="flex items-center justify-between pt-3 border-t border-slate-100">
                <span class="text-xs text-slate-500">{job.data.featuredSubjects.length} Core Subjects</span>
                <a
                  href={`/exams/${job.slug}`}
                  class="text-teal-600 font-semibold text-sm group-hover:translate-x-1 transition-transform inline-flex items-center gap-1"
                >
                  Syllabus & Guide →
                </a>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>

  <!-- Interactive Client-side Filter Script -->
  <script>
    const filterButtons = document.querySelectorAll('.filter-btn');
    const jobCards = document.querySelectorAll('.job-card');

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');

        // Update button styles
        filterButtons.forEach((b) => {
          b.classList.remove('bg-teal-600', 'text-white', 'shadow-sm');
          b.classList.add('bg-slate-100', 'text-slate-700');
        });
        btn.classList.add('bg-teal-600', 'text-white', 'shadow-sm');
        btn.classList.remove('bg-slate-100', 'text-slate-700');

        // Filter cards
        jobCards.forEach((card) => {
          const category = card.getAttribute('data-category');
          if (
            filter === 'all' ||
            category === filter ||
            (filter === 'fpsc' && (category === 'interior' || category === 'education' || category === 'health' || category === 'engineering')) ||
            (filter === 'kppsc' && (category === 'education' || category === 'health' || category === 'engineering' || category === 'kppsc'))
          ) {
            (card as HTMLElement).style.display = 'flex';
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });
      });
    });
  </script>
</BaseLayout>
