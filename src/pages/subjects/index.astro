---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { iconFor } from '../../lib/icons';

const subjects = await getCollection('subjects');
const mcqs = await getCollection('mcqs');

const questionsBySubject = new Map<string, number>();
const setsBySubject = new Map<string, number>();
for (const set of mcqs) {
  setsBySubject.set(set.data.subject, (setsBySubject.get(set.data.subject) ?? 0) + 1);
  questionsBySubject.set(set.data.subject, (questionsBySubject.get(set.data.subject) ?? 0) + set.data.questions.length);
}
subjects.sort((a, b) => (questionsBySubject.get(b.slug) ?? 0) - (questionsBySubject.get(a.slug) ?? 0));
---

<BaseLayout
  title="Subjects | ExamHub.pk"
  description="Browse all subjects covered for Pakistani competitive exams."
>
  <div class="bg-gradient-to-br from-slate-900 to-slate-800 text-white py-12">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">All Subjects</h1>
      <p class="text-xl text-slate-300 max-w-3xl">
        Master each subject with organized MCQs, detailed explanations, and exam-focused content.
      </p>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    {subjects.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {subjects.map(subject => {
          const questionCount = questionsBySubject.get(subject.slug) ?? 0;
          const setCount = setsBySubject.get(subject.slug) ?? 0;
          return (
            <a href={`/subjects/${subject.slug}`} class="card-hover group">
              <div class="flex items-start justify-between mb-3">
                <div>
                  <h3 class="text-lg font-bold text-slate-900 group-hover:text-teal-600">{subject.data.title}</h3>
                  <p class="text-xs text-slate-500 mt-1 font-medium">Weightage: {subject.data.syllabusWeightage}</p>
                </div>
                <div class="text-3xl">{iconFor(subject.data.icon)}</div>
              </div>
              <p class="text-sm text-slate-600 line-clamp-2 mb-3">{subject.data.description}</p>
              <div class="flex justify-between text-xs text-slate-500">
                <span>
                  {questionCount > 0
                    ? `${questionCount} questions in ${setCount} topic${setCount === 1 ? '' : 's'}`
                    : 'Syllabus overview'}
                </span>
                <span class="text-teal-600 font-medium">Explore →</span>
              </div>
            </a>
          );
        })}
      </div>
    ) : (
      <div class="text-center py-12">
        <p class="text-slate-600 text-lg">No subjects available yet.</p>
      </div>
    )}
  </div>
</BaseLayout>
