---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { iconFor } from '../../lib/icons';

export async function getStaticPaths() {
  const subjects = await getCollection('subjects');
  return subjects.map(subject => ({
    params: { slug: subject.slug },
    props: { subject },
  }));
}

interface Props {
  subject: any;
}

const { subject } = Astro.props;
const { Content } = await subject.render();

// Get MCQs for this subject
const allMcqs = await getCollection('mcqs');
const subjectMcqs = allMcqs.filter(mcq => mcq.data.subject === subject.slug);

const totalQuestions = subjectMcqs.reduce((sum, m) => sum + (m.data.questions?.length || 0), 0);
const declaredSlugs = new Set(subject.data.subtopics.map((st: any) => st.slug));

// Build unified topic list
const topicData = subject.data.subtopics.map((st: any) => {
  const matches = subjectMcqs.filter(m => m.data.topic === st.slug);
  const qCount = matches.reduce((sum, m) => sum + (m.data.questions?.length || 0), 0);
  const targetExams = matches.flatMap(m => m.data.targetExams || []);
  const uniqueExams = Array.from(new Set(targetExams));
  const difficulty = matches[0]?.data?.difficulty || 'Exam-Level';
  return {
    name: st.name,
    slug: st.slug,
    realCount: qCount,
    available: qCount > 0,
    targetExams: uniqueExams,
    difficulty,
    setsCount: matches.length,
  };
});

// Add any sets that were not explicitly listed in subtopics
const remainingMap = new Map<string, any>();
for (const m of subjectMcqs) {
  if (!declaredSlugs.has(m.data.topic) && !remainingMap.has(m.data.topic)) {
    const topicMatches = subjectMcqs.filter(other => other.data.topic === m.data.topic);
    const qCount = topicMatches.reduce((sum, other) => sum + (other.data.questions?.length || 0), 0);
    remainingMap.set(m.data.topic, {
      name: m.data.topicName || m.data.topic,
      slug: m.data.topic,
      realCount: qCount,
      available: qCount > 0,
      targetExams: m.data.targetExams || [],
      difficulty: m.data.difficulty || 'Exam-Level',
      setsCount: topicMatches.length,
    });
  }
}
for (const extra of remainingMap.values()) {
  topicData.push(extra);
}

// Sort topics: available first with highest question count
topicData.sort((a: any, b: any) => {
  if (a.available !== b.available) return a.available ? -1 : 1;
  return b.realCount - a.realCount;
});

const availableCount = topicData.filter((t: any) => t.available).length;
const pastPaperCount = topicData.filter((t: any) => t.name.toLowerCase().includes('past paper')).length;

const difficultyColors: Record<string, string> = {
  'Basic': 'bg-emerald-50 text-emerald-700 border-emerald-200',
  'Intermediate': 'bg-sky-50 text-sky-700 border-sky-200',
  'Advanced': 'bg-amber-50 text-amber-700 border-amber-200',
  'Exam-Level': 'bg-rose-50 text-rose-700 border-rose-200',
};
---

<BaseLayout
  title={`${subject.data.title} — MCQs, Syllabus & Test Preparation | ExamHub.pk`}
  description={subject.data.description}
>
  <!-- Breadcrumb -->
  <div class="bg-slate-50 border-b border-slate-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
      <nav class="flex items-center space-x-2 text-sm text-slate-600">
        <a href="/" class="hover:text-teal-600 font-medium transition-colors">Home</a>
        <span class="text-slate-400">/</span>
        <a href="/subjects" class="hover:text-teal-600 font-medium transition-colors">Subjects</a>
        <span class="text-slate-400">/</span>
        <span class="text-slate-900 font-semibold truncate">{subject.data.title}</span>
      </nav>
    </div>
  </div>

  <!-- Hero Header -->
  <section class="bg-gradient-to-br from-slate-950 via-slate-900 to-teal-950 text-white relative overflow-hidden py-12 md:py-16">
    <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#0d9488_1px,transparent_1px)] [background-size:16px_16px]"></div>
    
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 mb-8">
        <div class="max-w-3xl">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-teal-500/20 text-teal-300 text-xs font-semibold uppercase tracking-wider mb-4 border border-teal-500/30">
            <span>Discipline Hub</span>
            <span>•</span>
            <span>Updated Syllabus</span>
          </div>
          <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight mb-4">
            {subject.data.title}
          </h1>
          <p class="text-slate-300 text-base sm:text-lg leading-relaxed">
            {subject.data.description}
          </p>
        </div>
        
        <div class="hidden md:flex flex-col items-center justify-center p-6 bg-white/5 border border-white/10 rounded-2xl backdrop-blur-md shadow-xl text-center min-w-[200px]">
          <span class="text-5xl mb-2">{iconFor(subject.data.icon)}</span>
          <span class="text-xs uppercase tracking-wider text-teal-300 font-bold">Comprehensive Bank</span>
          <span class="text-2xl font-black text-white mt-1">{totalQuestions.toLocaleString()} MCQs</span>
        </div>
      </div>

      <!-- Quick Metrics Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4 pt-4 border-t border-slate-800">
        <div class="bg-slate-800/60 border border-slate-700/60 rounded-xl p-3.5 backdrop-blur-xs">
          <div class="text-xs font-medium text-slate-400">Total MCQs</div>
          <div class="text-xl sm:text-2xl font-black text-teal-300 mt-0.5">{totalQuestions.toLocaleString()}</div>
        </div>
        <div class="bg-slate-800/60 border border-slate-700/60 rounded-xl p-3.5 backdrop-blur-xs">
          <div class="text-xs font-medium text-slate-400">Topic Modules</div>
          <div class="text-xl sm:text-2xl font-black text-teal-300 mt-0.5">{topicData.length}</div>
        </div>
        <div class="bg-slate-800/60 border border-slate-700/60 rounded-xl p-3.5 backdrop-blur-xs">
          <div class="text-xs font-medium text-slate-400">Exam Weightage</div>
          <div class="text-xl sm:text-2xl font-black text-teal-300 mt-0.5">{subject.data.syllabusWeightage}</div>
        </div>
        <div class="bg-slate-800/60 border border-slate-700/60 rounded-xl p-3.5 backdrop-blur-xs">
          <div class="text-xs font-medium text-slate-400">Target Commissions</div>
          <div class="text-base sm:text-lg font-bold text-teal-300 mt-0.5 truncate">
            {subject.data.relatedExams.slice(0, 3).join(', ')}{subject.data.relatedExams.length > 3 ? '...' : ''}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content Layout -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
      
      <!-- Primary Column: Topic Search & Practice Grid -->
      <div class="lg:col-span-2 space-y-8">
        
        <!-- Practice Modules Browser -->
        <section id="topics-browser" class="bg-white rounded-2xl border border-slate-200/90 shadow-xs p-5 sm:p-7">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-5 border-b border-slate-100">
            <div>
              <h2 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight">
                Practice Modules & Question Sets
              </h2>
              <p class="text-xs sm:text-sm text-slate-500 mt-0.5">
                Select any module below to practice MCQs with detailed academic explanations.
              </p>
            </div>
            <div class="flex items-center gap-1.5 self-start sm:self-auto bg-teal-50 text-teal-800 font-semibold text-xs px-3 py-1.5 rounded-full border border-teal-200">
              <span class="w-2 h-2 rounded-full bg-teal-500 animate-pulse"></span>
              <span id="topic-count-display">{availableCount} Modules Available</span>
            </div>
          </div>

          <!-- Live Search & Filter Bar -->
          <div class="mt-5 mb-6">
            <div class="relative">
              <input
                type="text"
                id="topic-search-input"
                placeholder={`Search ${topicData.length} topics (e.g. Past Papers, Constitution, Syntax)...`}
                class="w-full pl-10 pr-4 py-3 rounded-xl border border-slate-200 focus:border-teal-500 focus:ring-3 focus:ring-teal-500/15 outline-hidden text-sm text-slate-800 placeholder-slate-400 transition"
              />
              <svg class="w-5 h-5 text-slate-400 absolute left-3.5 top-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
              <button
                id="clear-search-btn"
                class="hidden absolute right-3 top-3 text-xs bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-md px-2 py-1 font-semibold transition"
              >
                Clear
              </button>
            </div>
          </div>

          <!-- Topics Cards Grid -->
          <div id="topics-grid" class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {topicData.map((topic: any) => {
              if (!topic.available) {
                return (
                  <div
                    class="topic-card p-4 rounded-xl border border-dashed border-slate-200 bg-slate-50/70 opacity-70 flex flex-col justify-between"
                    data-topic-name={topic.name.toLowerCase()}
                    data-topic-exams={topic.targetExams.join(' ').toLowerCase()}
                  >
                    <div>
                      <span class="inline-block px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-slate-200 text-slate-600 mb-2">
                        In Preparation
                      </span>
                      <h3 class="font-bold text-slate-600 text-base mb-1">{topic.name}</h3>
                      <p class="text-xs text-slate-400">Curated questions being verified according to exam syllabus.</p>
                    </div>
                    <span class="mt-4 text-xs font-semibold text-slate-400">Coming soon</span>
                  </div>
                );
              }

              return (
                <a
                  href={`/mcqs/${subject.slug}/${topic.slug}`}
                  class="topic-card group p-5 rounded-xl border border-slate-200 hover:border-teal-500 hover:shadow-md bg-white hover:bg-teal-50/30 transition-all flex flex-col justify-between"
                  data-topic-name={topic.name.toLowerCase()}
                  data-topic-exams={topic.targetExams.join(' ').toLowerCase()}
                >
                  <div>
                    <div class="flex items-center justify-between gap-2 mb-2">
                      <span class={`inline-block px-2.5 py-0.5 rounded-full border text-[11px] font-bold ${difficultyColors[topic.difficulty] || 'bg-slate-100 text-slate-700 border-slate-200'}`}>
                        {topic.difficulty}
                      </span>
                      <span class="inline-flex items-center text-xs font-bold text-teal-800 bg-teal-100/80 px-2 py-0.5 rounded-md">
                        {topic.realCount} MCQs
                      </span>
                    </div>

                    <h3 class="font-bold text-slate-900 group-hover:text-teal-700 text-base leading-snug mb-2 transition-colors">
                      {topic.name}
                    </h3>

                    {topic.targetExams && topic.targetExams.length > 0 && (
                      <div class="flex flex-wrap gap-1 mb-3">
                        {topic.targetExams.slice(0, 3).map((exam: string) => (
                          <span class="text-[10px] font-semibold text-slate-600 bg-slate-100 px-1.5 py-0.5 rounded">
                            {exam}
                          </span>
                        ))}
                        {topic.targetExams.length > 3 && (
                          <span class="text-[10px] font-semibold text-slate-400 px-1">
                            +{topic.targetExams.length - 3} more
                          </span>
                        )}
                      </div>
                    )}
                  </div>

                  <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-xs font-semibold text-teal-600 group-hover:text-teal-700">
                    <span>Practice Questions</span>
                    <span class="group-hover:translate-x-1 transition-transform">→</span>
                  </div>
                </a>
              );
            })}
          </div>

          <!-- Empty state when search produces no result -->
          <div id="no-topics-found" class="hidden py-12 text-center">
            <svg class="w-12 h-12 text-slate-300 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <p class="text-base font-bold text-slate-700">No matching topics found</p>
            <p class="text-xs text-slate-500 mt-1">Try a different search term or clear the filter.</p>
          </div>
        </section>

        <!-- Subject Overview & Syllabus Card -->
        <section class="bg-white rounded-2xl border border-slate-200/90 shadow-xs p-6 sm:p-8">
          <h2 class="text-xl font-bold text-slate-900 mb-4 pb-3 border-b border-slate-100 flex items-center gap-2">
            <span>📖</span>
            <span>Subject Syllabus & Concept Blueprint</span>
          </h2>
          <div class="prose prose-slate max-w-none text-slate-700 leading-relaxed text-sm sm:text-base">
            <Content />
          </div>
        </section>
      </div>

      <!-- Secondary Column: Commission Exams, Tips & Tools -->
      <aside class="space-y-6">
        
        <!-- Related Commission Exams -->
        {subject.data.relatedExams.length > 0 && (
          <div class="bg-white rounded-2xl border border-slate-200/90 p-5 shadow-xs">
            <h3 class="font-bold text-slate-900 text-base mb-3 flex items-center gap-2">
              <span class="text-teal-600">🏛️</span>
              <span>Relevant Competitive Exams</span>
            </h3>
            <p class="text-xs text-slate-500 mb-4">
              Questions from this discipline frequently appear in test papers for:
            </p>
            <div class="flex flex-wrap gap-2">
              {subject.data.relatedExams.map((exam: string) => (
                <a
                  href={`/exams/${exam.toLowerCase()}`}
                  class="px-3 py-1.5 rounded-lg bg-teal-50 hover:bg-teal-100 text-teal-800 border border-teal-200/70 text-xs font-bold transition-colors"
                >
                  {exam}
                </a>
              ))}
            </div>
          </div>
        )}

        <!-- Preparation Strategy Card -->
        <div class="bg-gradient-to-br from-slate-900 to-slate-800 text-white rounded-2xl p-5 shadow-xs">
          <h3 class="font-bold text-teal-300 text-base mb-3 flex items-center gap-2">
            <span>⚡</span>
            <span>How to Score High</span>
          </h3>
          <ul class="text-xs text-slate-300 space-y-2.5 leading-relaxed">
            <li class="flex items-start gap-2">
              <span class="text-teal-400 font-bold">•</span>
              <span><strong>Solve in sets:</strong> Practice 40 questions at a time under timed conditions to simulate actual commission test pressure.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-teal-400 font-bold">•</span>
              <span><strong>Read explanations:</strong> Do not just memorize options; study the pedagogical context provided under every question.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-teal-400 font-bold">•</span>
              <span><strong>Review mistakes:</strong> Bookmark questions you miss and repeat the module until achieving 90%+ accuracy.</span>
            </li>
          </ul>
        </div>

        <!-- Mobile App Download Callout -->
        <div class="bg-gradient-to-br from-teal-50 to-emerald-50 border border-teal-200/80 rounded-2xl p-5">
          <div class="flex items-center gap-2 text-teal-900 font-bold text-sm mb-1">
            <span>📱</span>
            <span>Practice on Mobile App</span>
          </div>
          <p class="text-xs text-teal-800 leading-relaxed mb-3">
            Offline practice mode, instant bookmarks, and personalized mock tests for FPSC & PPSC.
          </p>
          <a
            href="https://play.google.com/store/apps/details?id=com.examhub.app"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center w-full px-4 py-2.5 rounded-xl bg-teal-700 hover:bg-teal-800 text-white text-xs font-bold shadow-xs transition"
          >
            Get App on Google Play →
          </a>
        </div>

        <!-- Quick Subject Switcher -->
        <div class="bg-white rounded-2xl border border-slate-200/90 p-5 shadow-xs">
          <h3 class="font-bold text-slate-900 text-sm mb-3">All Disciplines</h3>
          <a
            href="/subjects"
            class="inline-flex items-center justify-between w-full px-3.5 py-2.5 rounded-xl border border-slate-200 hover:border-teal-400 text-slate-700 text-xs font-semibold hover:bg-slate-50 transition"
          >
            <span>Browse All 43 Subjects</span>
            <span>→</span>
          </a>
        </div>
      </aside>

    </div>
  </main>

  <!-- Client-side Topic Filtering Script -->
  <script is:inline>
    (function() {
      const searchInput = document.getElementById('topic-search-input');
      const clearBtn = document.getElementById('clear-search-btn');
      const cards = document.querySelectorAll('.topic-card');
      const noFound = document.getElementById('no-topics-found');
      const countDisplay = document.getElementById('topic-count-display');

      if (!searchInput) return;

      function filterTopics() {
        const query = searchInput.value.trim().toLowerCase();
        let visibleCount = 0;

        if (query) {
          clearBtn.classList.remove('hidden');
        } else {
          clearBtn.classList.add('hidden');
        }

        cards.forEach((card) => {
          const name = card.getAttribute('data-topic-name') || '';
          const exams = card.getAttribute('data-topic-exams') || '';
          const matches = !query || name.includes(query) || exams.includes(query);

          if (matches) {
            card.style.display = '';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        if (visibleCount === 0) {
          noFound.classList.remove('hidden');
        } else {
          noFound.classList.add('hidden');
        }

        if (countDisplay) {
          countDisplay.textContent = query
            ? `${visibleCount} of ${cards.length} Modules`
            : `${cards.length} Modules Available`;
        }
      }

      searchInput.addEventListener('input', filterTopics);

      if (clearBtn) {
        clearBtn.addEventListener('click', () => {
          searchInput.value = '';
          filterTopics();
          searchInput.focus();
        });
      }
    })();
  </script>

  <!-- Breadcrumb JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://examhub.pk"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Subjects",
        "item": "https://examhub.pk/subjects"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": subject.data.title,
        "item": `https://examhub.pk/subjects/${subject.slug}`
      }
    ]
  })} />

  <!-- Course & Curriculum JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Course",
    "name": `${subject.data.title} — Syllabus & MCQ Preparation`,
    "description": subject.data.description,
    "provider": {
      "@type": "Organization",
      "name": "ExamHub.pk",
      "url": "https://examhub.pk"
    },
    "educationalLevel": "Competitive Examination Level",
    "inLanguage": "en-PK",
    "hasCourseInstance": {
      "@type": "CourseInstance",
      "courseMode": "Online",
      "courseWorkload": `${totalQuestions} Verified Questions across ${topicData.length} Topics`
    }
  })} />
</BaseLayout>
