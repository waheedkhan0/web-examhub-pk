---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllExamBlueprints } from '../../lib/syllabus-blueprints';

const blueprints = getAllExamBlueprints();

const categories = [
  { id: 'all', name: 'All Exams & Posts' },
  { id: 'healthcare', name: 'Healthcare & Nursing' },
  { id: 'engineering', name: 'Engineering & Technical' },
  { id: 'interior', name: 'FIA & Interior' },
  { id: 'academia', name: 'Lecturer & Academia' },
  { id: 'commissions', name: 'FPSC, PPSC & Commissions' },
];

function getCategory(slug: string): string {
  if (slug === 'charge-nurse' || slug === 'medical-officer') return 'healthcare';
  if (slug === 'civil-engineer') return 'engineering';
  if (slug === 'fia' || slug === 'ministry-of-interior') return 'interior';
  if (slug === 'fpsc-lecturer' || slug === 'associate-professor') return 'academia';
  return 'commissions';
}
---

<BaseLayout
  title="Timed Mock Tests & Solved Past Papers Hub | FPSC, KPPSC, PPSC | ExamHub.pk"
  description="Take free full-length timed mock tests tailored according to official commission syllabus schemes. Solved past papers for FIA, Charge Nurse, Civil Engineer, Medical Officer, and FPSC tests."
>
  <!-- Hero Section -->
  <div class="bg-gradient-to-br from-slate-900 via-slate-800 to-teal-950 text-white py-14 md:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-teal-500/20 border border-teal-400/30 text-teal-300 text-xs font-bold mb-4">
        <span>⏱️</span> Official Examination Simulation Hub
      </div>
      <h1 class="text-3xl sm:text-5xl font-black mb-4 tracking-tight">
        Syllabus Mock Tests & <span class="text-teal-400">Solved Past Papers</span>
      </h1>
      <p class="text-lg sm:text-xl text-slate-300 max-w-3xl leading-relaxed mb-8">
        Practice under real exam hall conditions. Every mock test automatically draws questions across the official syllabus weightages of Pakistani recruitment commissions and departments.
      </p>

      <div class="flex flex-wrap gap-4 text-xs font-semibold text-slate-300">
        <span class="inline-flex items-center gap-1.5 bg-white/10 px-3 py-1.5 rounded-lg border border-white/10">
          <span class="text-teal-300 font-bold">✓</span> Real-Time Countdown Timer
        </span>
        <span class="inline-flex items-center gap-1.5 bg-white/10 px-3 py-1.5 rounded-lg border border-white/10">
          <span class="text-teal-300 font-bold">✓</span> Section-by-Section Accuracy Breakdown
        </span>
        <span class="inline-flex items-center gap-1.5 bg-white/10 px-3 py-1.5 rounded-lg border border-white/10">
          <span class="text-teal-300 font-bold">✓</span> Verified Academic Explanations
        </span>
      </div>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Category Filter Bar -->
    <div class="flex flex-wrap gap-2 mb-10 pb-4 border-b border-slate-200">
      {categories.map((c, idx) => (
        <button
          type="button"
          class={`filter-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-bold transition cursor-pointer ${
            idx === 0
              ? 'bg-teal-600 text-white shadow-xs'
              : 'bg-slate-100 text-slate-700 hover:bg-slate-200'
          }`}
          data-category={c.id}
        >
          {c.name}
        </button>
      ))}
    </div>

    <!-- Blueprints Mock Test Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="mock-grid">
      {blueprints.map((b) => {
        const cat = getCategory(b.slug);
        const totalPastPapers = b.pastPapers.length;
        return (
          <div
            class="mock-card bg-white rounded-2xl border border-slate-200 p-6 shadow-xs hover:border-teal-500 hover:shadow-md transition-all flex flex-col justify-between"
            data-category={cat}
          >
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class="inline-block px-2.5 py-1 rounded-md text-2xs font-black uppercase tracking-wider bg-teal-50 text-teal-800 border border-teal-200">
                  {b.conductingBody.split('(')[0].trim()}
                </span>
                <span class="text-xs font-bold text-slate-500">
                  Passing: {b.passingPercent}%
                </span>
              </div>

              <h2 class="text-lg font-bold text-slate-900 mb-2">
                {b.title}
              </h2>
              <p class="text-xs text-slate-500 mb-4 line-clamp-2">
                {b.fullName}
              </p>

              <!-- Syllabus Breakdown Pill Preview -->
              <div class="space-y-1.5 mb-5 bg-slate-50 p-3 rounded-xl border border-slate-100 text-2xs">
                <p class="font-bold text-slate-700 mb-1">Official Syllabus Distribution:</p>
                {b.sections.slice(0, 3).map((s) => (
                  <div class="flex items-center justify-between text-slate-600">
                    <span class="truncate pr-2">• {s.name.split(':')[0]}</span>
                    <span class="font-bold text-teal-700">{s.weightagePercent}%</span>
                  </div>
                ))}
                {b.sections.length > 3 && (
                  <p class="text-slate-400 font-medium pt-1">+ {b.sections.length - 3} more syllabus sections</p>
                )}
              </div>
            </div>

            <div class="pt-4 border-t border-slate-100 space-y-2">
              <div class="flex items-center justify-between text-xs text-slate-500 pb-2">
                <span>⏱️ {b.durationMinutesDefault} mins</span>
                <span class="font-semibold text-teal-700">📚 {totalPastPapers} Solved Papers</span>
              </div>

              <div class="grid grid-cols-2 gap-2">
                <a
                  href={`/exams/${b.slug}#mock-test-section`}
                  class="text-center px-3 py-2 rounded-xl bg-teal-600 hover:bg-teal-700 text-white font-bold text-xs transition shadow-xs"
                >
                  Start Mock Test
                </a>
                <a
                  href={`/exams/${b.slug}#past-papers-section`}
                  class="text-center px-3 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 font-semibold text-xs transition"
                >
                  Past Papers
                </a>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</BaseLayout>

<script>
  function setupFilters() {
    const filterBtns = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.mock-card');

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const cat = btn.getAttribute('data-category');

        filterBtns.forEach((b) => {
          b.classList.remove('bg-teal-600', 'text-white', 'shadow-xs');
          b.classList.add('bg-slate-100', 'text-slate-700');
        });
        btn.classList.add('bg-teal-600', 'text-white', 'shadow-xs');
        btn.classList.remove('bg-slate-100', 'text-slate-700');

        cards.forEach((card: any) => {
          const cardCat = card.getAttribute('data-category');
          if (cat === 'all' || cardCat === cat) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  }

  document.addEventListener('DOMContentLoaded', setupFilters);
  document.addEventListener('astro:after-swap', setupFilters);
</script>
