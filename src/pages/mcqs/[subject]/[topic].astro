---
import { getCollection } from 'astro:content';
import MCQLayout from '../../../layouts/MCQLayout.astro';

export async function getStaticPaths() {
  const mcqs = await getCollection('mcqs');
  
  // Pre-index by subject once (O(N)) instead of filtering 2,200 times (O(N^2))
  const bySubject = new Map<string, { subject: string; topic: string; topicName: string; count: number }[]>();
  for (const m of mcqs) {
    let list = bySubject.get(m.data.subject);
    if (!list) {
      list = [];
      bySubject.set(m.data.subject, list);
    }
    list.push({
      subject: m.data.subject,
      topic: m.data.topic,
      topicName: m.data.topicName,
      count: m.data.questions?.length || 0,
    });
  }

  return mcqs.map(mcq => ({
    params: { subject: mcq.data.subject, topic: mcq.data.topic },
    props: {
      mcq,
      relatedSets: (bySubject.get(mcq.data.subject) || [])
        .filter(other => other.topic !== mcq.data.topic)
        .slice(0, 6),
    },
  }));
}

interface Props {
  mcq: any;
  relatedSets: { subject: string; topic: string; topicName: string; count: number }[];
}

const { mcq, relatedSets } = Astro.props;
---

<MCQLayout
  title={mcq.data.title}
  description={mcq.data.description}
  subject={mcq.data.subject}
  subjectName={mcq.data.subjectName}
  topic={mcq.data.topic}
  topicName={mcq.data.topicName}
  difficulty={mcq.data.difficulty}
  targetExams={mcq.data.targetExams}
  questions={mcq.data.questions}
  updatedDate={mcq.data.updatedDate}
  relatedSets={relatedSets}
/>
