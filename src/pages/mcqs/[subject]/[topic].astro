---
import { getCollection } from 'astro:content';
import MCQLayout from '../../../layouts/MCQLayout.astro';

export async function getStaticPaths() {
  const mcqs = await getCollection('mcqs');
  return mcqs.map(mcq => ({
    params: { subject: mcq.data.subject, topic: mcq.data.topic },
    props: {
      mcq,
      relatedSets: mcqs
        .filter(other => other.data.subject === mcq.data.subject && other.data.topic !== mcq.data.topic)
        .map(other => ({
          subject: other.data.subject,
          topic: other.data.topic,
          topicName: other.data.topicName,
          count: other.data.questions.length,
        }))
        .slice(0, 6),
    },
  }));
}

interface Props {
  mcq: any;
  relatedSets: { subject: string; topic: string; topicName: string; count: number }[];
}

const { mcq, relatedSets } = Astro.props;
const { Content } = await mcq.render();
---

<MCQLayout
  title={mcq.data.title}
  description={mcq.data.description}
  subject={mcq.data.subject}
  subjectName={mcq.data.subjectName}
  topic={mcq.data.topic}
  topicName={mcq.data.topicName}
  difficulty={mcq.data.difficulty}
  targetExams={mcq.data.targetExams}
  questions={mcq.data.questions}
  updatedDate={mcq.data.updatedDate}
  relatedSets={relatedSets}
>
  <Content />
</MCQLayout>
