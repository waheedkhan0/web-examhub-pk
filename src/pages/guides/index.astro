---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const guides = await getCollection('guides');
const sortedGuides = guides.sort((a, b) => 
  new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()
);
---

<BaseLayout
  title="Study Guides | ExamHub.pk"
  description="Comprehensive study guides for Pakistani competitive exams covering CSS, PMS, PPSC, FPSC, and more."
>
  <!-- Header -->
  <div class="bg-gradient-to-br from-slate-900 to-slate-800 text-white py-12">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Study Guides</h1>
      <p class="text-xl text-slate-300 max-w-3xl">
        In-depth preparation guides covering exam strategies, syllabus breakdown, and expert study tips.
      </p>
    </div>
  </div>

  <!-- Content -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    {sortedGuides.length > 0 ? (
      <>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {sortedGuides.map(guide => (
            <a href={`/guides/${guide.slug}`} class="card-hover group">
              {guide.data.featured && (
                <div class="mb-3">
                  <span class="inline-block px-3 py-1 bg-yellow-100 text-yellow-800 text-xs font-bold rounded-full">
                    ⭐ Featured
                  </span>
                </div>
              )}
              <h3 class="text-lg font-bold text-slate-900 group-hover:text-teal-600 mb-2 line-clamp-2">
                {guide.data.title}
              </h3>
              <p class="text-sm text-slate-600 line-clamp-3 mb-4">{guide.data.description}</p>
              <div class="flex flex-wrap gap-2 mb-4">
                {guide.data.targetExams.map((exam: string) => (
                  <span class="text-xs bg-teal-50 text-teal-700 px-2 py-1 rounded-full">{exam}</span>
                ))}
              </div>
              <div class="flex items-center justify-between text-xs text-slate-500">
                <span>{guide.data.readingTime}</span>
                <span class="text-teal-600 font-medium group-hover:translate-x-1 transition-transform">Read →</span>
              </div>
            </a>
          ))}
        </div>
      </>
    ) : (
      <div class="text-center py-12">
        <p class="text-slate-600 text-lg">No guides available yet.</p>
      </div>
    )}
  </div>
</BaseLayout>
