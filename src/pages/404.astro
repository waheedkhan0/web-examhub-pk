---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found | ExamHub.pk"
  description="Sorry, the page you're looking for doesn't exist."
  noindex={true}
  showAds={false}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-20 text-center">
    <div class="mb-8">
      <div class="text-8xl font-bold text-slate-200 mb-4">404</div>
      <h1 class="text-4xl font-bold text-slate-900 mb-4">Page Not Found</h1>
      <p class="text-xl text-slate-600 mb-8">
        Sorry, the page you're looking for doesn't exist or has been moved.
      </p>
    </div>

    <div class="bg-blue-50 border border-blue-200 rounded-lg p-6 mb-8 inline-block">
      <p class="text-slate-700">
        Let's get you back on track. Here are some helpful links:
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
      <a href="/" class="card-hover">
        <h3 class="font-bold text-slate-900">Home</h3>
        <p class="text-sm text-slate-600">Return to homepage</p>
      </a>
      <a href="/mcqs" class="card-hover">
        <h3 class="font-bold text-slate-900">Practice MCQs</h3>
        <p class="text-sm text-slate-600">Start practicing</p>
      </a>
      <a href="/subjects" class="card-hover">
        <h3 class="font-bold text-slate-900">Subjects</h3>
        <p class="text-sm text-slate-600">Browse by subject</p>
      </a>
    </div>

    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a href="/" class="btn btn-primary">Go Home</a>
      <a href="/contact" class="btn btn-secondary">Report Issue</a>
    </div>
  </div>
</BaseLayout>
