---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const exams = await getCollection('exams');

// Sort by posts with case numbers or newest first
const sortedExams = exams.sort((a, b) => {
  const aHasCase = a.data.caseNo ? 1 : 0;
  const bHasCase = b.data.caseNo ? 1 : 0;
  if (aHasCase !== bHasCase) return bHasCase - aHasCase;
  return (b.data.updatedDate || '').localeCompare(a.data.updatedDate || '');
});
---

<BaseLayout
  title="Competitive Exams & Commission Recruitment Tests | FPSC, KPPSC, PPSC | ExamHub.pk"
  description="Complete preparation guides, official syllabi breakdowns, past papers, and interactive practice mock tests for all major Pakistani competitive exams and public service commission tests."
>
  <div class="bg-gradient-to-br from-slate-950 via-slate-900 to-teal-950 text-white py-14 relative overflow-hidden">
    <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#0d9488_1px,transparent_1px)] [background-size:16px_16px]"></div>

    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-teal-500/20 border border-teal-400/30 text-teal-300 text-xs sm:text-sm font-semibold mb-4">
        <span>🇵🇰</span> Federal & Provincial Competitive Portals
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold mb-4 tracking-tight">
        Competitive Exams & <span class="text-teal-400">Commission Tests</span>
      </h1>

      <p class="text-base sm:text-lg text-slate-300 max-w-3xl leading-relaxed">
        Comprehensive preparation materials, official syllabi breakdowns, and interactive mock tests for Pakistan's most competitive civil service, departmental, and professional examinations.
      </p>

      <div class="flex flex-wrap gap-3 mt-8">
        <a href="/jobs" class="btn btn-primary inline-flex items-center gap-2">
          <span>🏛️</span> Browse All Advertised Commission Posts
        </a>
        <a href="/mcqs" class="btn btn-secondary inline-flex items-center gap-2">
          <span>📝</span> Practice MCQs by Subject
        </a>
      </div>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    {sortedExams.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {sortedExams.map(exam => {
          const commission = exam.data.commission || (exam.data.conductingBody.includes('FPSC') ? 'FPSC' : exam.data.conductingBody.includes('KPPSC') ? 'KPPSC' : 'Recruitment');
          const mockCount = exam.data.mockTests?.length || 0;

          return (
            <a
              href={`/exams/${exam.slug}`}
              class="card-hover group border border-slate-200 rounded-2xl p-6 bg-white hover:border-teal-400 transition-all flex flex-col justify-between shadow-xs hover:shadow-lg"
            >
              <div>
                <div class="flex items-center justify-between gap-2 mb-3">
                  <span class="inline-block px-2.5 py-1 text-[11px] font-black uppercase tracking-wider rounded-md bg-teal-50 text-teal-800 border border-teal-200">
                    {commission}
                  </span>
                  {exam.data.scale && (
                    <span class="px-2 py-0.5 text-[11px] font-bold rounded-md bg-sky-50 text-sky-800 border border-sky-200">
                      {exam.data.scale}
                    </span>
                  )}
                  {exam.data.caseNo && (
                    <span class="px-2 py-0.5 text-[11px] font-bold rounded-md bg-amber-50 text-amber-800 border border-amber-200 truncate max-w-[120px]">
                      {exam.data.caseNo.split('(')[0].trim()}
                    </span>
                  )}
                </div>

                <h2 class="text-lg font-bold text-slate-900 group-hover:text-teal-600 transition mb-1 leading-snug">
                  {exam.data.title}
                </h2>
                
                <p class="text-xs text-slate-500 font-medium mb-3 line-clamp-1">
                  {exam.data.fullName}
                </p>

                <p class="text-xs text-slate-600 line-clamp-3 mb-4 leading-relaxed">
                  {exam.data.description}
                </p>
              </div>

              <div>
                <div class="grid grid-cols-2 gap-2 text-xs mb-4">
                  {exam.data.keyStats.slice(0, 2).map((stat: any) => (
                    <div class="bg-slate-50 p-2.5 rounded-xl border border-slate-100">
                      <div class="font-bold text-slate-900">{stat.value}</div>
                      <div class="text-slate-500 text-[11px] truncate">{stat.label}</div>
                    </div>
                  ))}
                </div>

                {mockCount > 0 && (
                  <div class="text-[11px] font-bold text-emerald-700 bg-emerald-50 px-2 py-1 rounded-md border border-emerald-200 mb-3 text-center">
                    🚀 {mockCount} Interactive Mock Tests Included
                  </div>
                )}

                <div class="flex items-center justify-between pt-3 border-t border-slate-100 text-xs">
                  <span class="text-slate-500">{exam.data.featuredSubjects.length} Core Subjects</span>
                  <span class="text-teal-600 font-bold group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
                    Syllabus & Tests →
                  </span>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    ) : (
      <div class="text-center py-12">
        <p class="text-slate-600 text-lg">No exams available yet.</p>
      </div>
    )}
  </div>
</BaseLayout>
