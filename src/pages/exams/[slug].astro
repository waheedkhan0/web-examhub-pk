---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SyllabusMockTest from '../../components/SyllabusMockTest.astro';
import { getExamBlueprint } from '../../lib/syllabus-blueprints';

export async function getStaticPaths() {
  const allExams = await getCollection('exams');
  return allExams.map(exam => {
    const related = allExams
      .filter(e => e.slug !== exam.slug && (e.data.commission === exam.data.commission || e.data.category === exam.data.category))
      .slice(0, 3);
    return {
      params: { slug: exam.slug },
      props: { 
        exam,
        relatedExams: related.length > 0 ? related : allExams.filter(e => e.slug !== exam.slug).slice(0, 3)
      },
    };
  });
}

interface Props {
  exam: any;
  relatedExams: any[];
}

const { exam, relatedExams } = Astro.props;
const { Content } = await exam.render();

const commission = exam.data.commission || (exam.data.conductingBody.includes('FPSC') ? 'FPSC' : exam.data.conductingBody.includes('KPPSC') ? 'KPPSC' : 'Federal');
const caseNo = exam.data.caseNo;
const scale = exam.data.scale;
const department = exam.data.department;
const blueprint = getExamBlueprint(exam.slug);
---

<BaseLayout
  title={`${exam.data.fullName} - Syllabus, Past Papers & Mock Tests | ExamHub.pk`}
  description={`Complete preparation for ${exam.data.fullName}. Free syllabus-based mock tests, verified solved past papers, official mark distribution, and high-yield MCQs for ${exam.data.conductingBody}.`}
>
  <!-- Breadcrumbs -->
  <div class="bg-slate-50 border-b border-slate-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
      <nav class="flex items-center space-x-2 text-sm text-slate-600 flex-wrap">
        <a href="/" class="hover:text-teal-600">Home</a>
        <span>/</span>
        <a href="/jobs" class="hover:text-teal-600">Advertised Posts</a>
        <span>/</span>
        <a href="/exams" class="hover:text-teal-600">Exams</a>
        <span>/</span>
        <span class="text-slate-900 font-medium truncate">{exam.data.title}</span>
      </nav>
    </div>
  </div>

  <!-- Hero Header -->
  <div class="bg-gradient-to-br from-slate-950 via-slate-900 to-teal-950 text-white py-12 md:py-16 relative overflow-hidden">
    <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#0d9488_1px,transparent_1px)] [background-size:16px_16px]"></div>
    
    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Badges row -->
      <div class="flex flex-wrap items-center gap-2 mb-4">
        <span class="px-3 py-1 text-xs font-bold uppercase tracking-wider rounded-full bg-teal-500/20 text-teal-300 border border-teal-400/30">
          🏛️ {commission} Official Recruitment
        </span>
        {caseNo && (
          <span class="px-3 py-1 text-xs font-bold rounded-full bg-amber-500/20 text-amber-300 border border-amber-400/30">
            📌 {caseNo}
          </span>
        )}
        {scale && (
          <span class="px-3 py-1 text-xs font-bold rounded-full bg-sky-500/20 text-sky-300 border border-sky-400/30">
            ⭐ {scale}
          </span>
        )}
        {department && (
          <span class="px-3 py-1 text-xs font-semibold rounded-full bg-white/10 text-slate-300 border border-white/20">
            🏢 {department}
          </span>
        )}
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight mb-4 text-white">
        {exam.data.fullName}
      </h1>
      
      <p class="text-lg md:text-xl text-slate-300 mb-8 max-w-3xl leading-relaxed">
        {exam.data.description}
      </p>

      <!-- Key Stats Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4 mb-8">
        {exam.data.keyStats.map((stat: any) => (
          <div class="bg-white/10 backdrop-blur-md rounded-xl p-4 border border-white/10 shadow-xs">
            <div class="text-teal-300 font-extrabold text-lg sm:text-xl">{stat.value}</div>
            <div class="text-xs sm:text-sm text-slate-300 font-medium">{stat.label}</div>
          </div>
        ))}
      </div>

      <!-- Quick Action CTAs -->
      <div class="flex flex-wrap items-center gap-3">
        {blueprint && (
          <a
            href="#mock-test-section"
            class="px-5 py-2.5 rounded-xl bg-teal-500 hover:bg-teal-600 text-slate-950 font-bold text-sm shadow transition hover:shadow-md inline-flex items-center gap-2"
          >
            <span>⚡ Start Official Mock Test</span>
          </a>
        )}
        {blueprint && blueprint.pastPapers && blueprint.pastPapers.length > 0 && (
          <a
            href="#past-papers-section"
            class="px-5 py-2.5 rounded-xl bg-white/15 hover:bg-white/25 text-white font-semibold text-sm transition inline-flex items-center gap-2 border border-white/20"
          >
            <span>📚 Solved Past Papers ({blueprint.pastPapers.length})</span>
          </a>
        )}
        <a
          href="#guide-content"
          class="px-5 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-medium text-sm transition"
        >
          <span>Syllabus Breakdown ↓</span>
        </a>
      </div>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-12">
    <!-- 1. OFFICIAL SYLLABUS MOCK TEST ENGINE -->
    {blueprint && (
      <section id="mock-test-section" class="scroll-mt-20">
        <SyllabusMockTest blueprint={blueprint} />
      </section>
    )}

    <!-- 2. SOLVED PAST PAPERS SECTION -->
    {blueprint && blueprint.pastPapers && blueprint.pastPapers.length > 0 && (
      <section id="past-papers-section" class="scroll-mt-20">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 pb-4 border-b border-slate-200">
          <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-100 text-emerald-800 text-xs font-bold mb-2">
              <span>📖</span> Commission Solved Papers
            </div>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
              {exam.data.title} — Solved Past Papers
            </h2>
            <p class="text-sm text-slate-600 mt-1">
              Attempt original past papers conducted by {blueprint.conductingBody} with step-by-step verified explanations.
            </p>
          </div>
          <span class="text-xs font-bold px-3 py-1.5 rounded-xl bg-slate-100 text-slate-700 self-start sm:self-auto">
            {blueprint.pastPapers.length} Verified Papers Available
          </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
          {blueprint.pastPapers.map((paper) => (
            <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-xs hover:border-teal-500 hover:shadow-md transition-all flex flex-col justify-between group">
              <div>
                <div class="flex items-center justify-between gap-2 mb-3">
                  <span class="inline-block px-2.5 py-1 rounded-md text-2xs font-black uppercase tracking-wider bg-teal-50 text-teal-800 border border-teal-200">
                    {paper.agency}
                  </span>
                  <span class="text-xs font-bold text-slate-500">
                    {paper.year}
                  </span>
                </div>

                <h3 class="text-base font-bold text-slate-900 group-hover:text-teal-700 transition mb-2">
                  {paper.title}
                </h3>
                <p class="text-xs text-slate-500 mb-4">
                  Target Post: <span class="text-slate-800 font-semibold">{paper.post}</span>
                </p>
              </div>

              <div class="pt-4 border-t border-slate-100 flex items-center justify-between gap-3">
                <span class="inline-flex items-center gap-1.5 text-xs font-bold text-slate-600">
                  <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                  {paper.questionCount} Questions Solved
                </span>

                <a
                  href={`/mcqs/${paper.subjectSlug}/${paper.topicSlug}`}
                  class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-teal-600 hover:bg-teal-700 text-white font-bold text-xs transition shadow-xs"
                >
                  <span>Solve Paper</span>
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- 3. OFFICIAL SYLLABUS & ELIGIBILITY GUIDE (MARKDOWN CONTENT) -->
    <section id="guide-content" class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-10 shadow-xs scroll-mt-20">
      <article class="prose prose-slate prose-lg max-w-none prose-headings:font-bold prose-headings:tracking-tight prose-a:text-teal-600 hover:prose-a:text-teal-700 prose-img:rounded-2xl">
        <Content />
      </article>
    </section>

    <!-- 4. FEATURED SUBJECTS REVISION CARDS -->
    {exam.data.featuredSubjects && exam.data.featuredSubjects.length > 0 && (
      <section class="bg-slate-50 rounded-3xl border border-slate-200/90 p-6 sm:p-8">
        <h3 class="text-xl font-bold text-slate-900 mb-2">
          Recommended Subject Preparation Modules
        </h3>
        <p class="text-xs sm:text-sm text-slate-600 mb-6">
          Master the core curriculum subjects required for {exam.data.title}:
        </p>
        <div class="flex flex-wrap gap-2.5">
          {exam.data.featuredSubjects.map((sub: string) => (
            <a
              href="/mcqs"
              class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-white border border-slate-200 hover:border-teal-500 hover:bg-teal-50/50 text-slate-800 font-semibold text-xs transition shadow-2xs"
            >
              <span class="w-2 h-2 rounded-full bg-teal-500"></span>
              <span>{sub}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- 5. RELATED RECRUITMENT POSTS -->
    {relatedExams && relatedExams.length > 0 && (
      <section class="bg-white rounded-2xl p-6 sm:p-8 border border-slate-200 shadow-sm">
        <h3 class="font-extrabold text-slate-900 text-lg mb-4 pb-2 border-b border-slate-100 flex items-center gap-2">
          <span>🎯</span> Other Advertised Posts & Examinations
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {relatedExams.map((rel: any) => (
            <a
              href={`/exams/${rel.slug}`}
              class="block p-4 rounded-xl bg-slate-50 hover:bg-teal-50 border border-slate-200 hover:border-teal-300 transition group"
            >
              <div class="text-xs font-bold text-teal-700 mb-1">
                {rel.data.scale ? `${rel.data.scale} • ` : ''}{rel.data.commission || 'Recruitment'}
              </div>
              <h4 class="text-sm font-bold text-slate-900 group-hover:text-teal-600 transition leading-snug line-clamp-1 mb-1">
                {rel.data.title}
              </h4>
              <p class="text-xs text-slate-500 line-clamp-2">
                {rel.data.fullName}
              </p>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>
