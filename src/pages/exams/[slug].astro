---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const allExams = await getCollection('exams');
  return allExams.map(exam => {
    const related = allExams
      .filter(e => e.slug !== exam.slug && (e.data.commission === exam.data.commission || e.data.category === exam.data.category))
      .slice(0, 3);
    return {
      params: { slug: exam.slug },
      props: { 
        exam,
        relatedExams: related.length > 0 ? related : allExams.filter(e => e.slug !== exam.slug).slice(0, 3)
      },
    };
  });
}

interface Props {
  exam: any;
  relatedExams: any[];
}

const { exam, relatedExams } = Astro.props;
const { Content } = await exam.render();

const commission = exam.data.commission || (exam.data.conductingBody.includes('FPSC') ? 'FPSC' : exam.data.conductingBody.includes('KPPSC') ? 'KPPSC' : 'Federal');
const caseNo = exam.data.caseNo;
const scale = exam.data.scale;
const department = exam.data.department;
const syllabus = exam.data.syllabusBreakdown;
const mockTests = exam.data.mockTests;
---

<BaseLayout
  title={`${exam.data.fullName} - Syllabus, Past Papers & Mock Tests | ExamHub.pk`}
  description={exam.data.description}
>
  <!-- Breadcrumb -->
  <div class="bg-slate-50 border-b border-slate-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
      <nav class="flex items-center space-x-2 text-sm text-slate-600 flex-wrap">
        <a href="/" class="hover:text-teal-600">Home</a>
        <span>/</span>
        <a href="/jobs" class="hover:text-teal-600">Advertised Posts</a>
        <span>/</span>
        <a href="/exams" class="hover:text-teal-600">Exams</a>
        <span>/</span>
        <span class="text-slate-900 font-medium truncate">{exam.data.title}</span>
      </nav>
    </div>
  </div>

  <!-- Hero Header -->
  <div class="bg-gradient-to-br from-slate-950 via-slate-900 to-teal-950 text-white py-12 md:py-16 relative overflow-hidden">
    <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#0d9488_1px,transparent_1px)] [background-size:16px_16px]"></div>
    
    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Badges row -->
      <div class="flex flex-wrap items-center gap-2 mb-4">
        <span class="px-3 py-1 text-xs font-bold uppercase tracking-wider rounded-full bg-teal-500/20 text-teal-300 border border-teal-400/30">
          🏛️ {commission} Official Recruitment
        </span>
        {caseNo && (
          <span class="px-3 py-1 text-xs font-bold rounded-full bg-amber-500/20 text-amber-300 border border-amber-400/30">
            📌 {caseNo}
          </span>
        )}
        {scale && (
          <span class="px-3 py-1 text-xs font-bold rounded-full bg-sky-500/20 text-sky-300 border border-sky-400/30">
            ⭐ {scale}
          </span>
        )}
        {department && (
          <span class="px-3 py-1 text-xs font-semibold rounded-full bg-white/10 text-slate-300 border border-white/20">
            🏢 {department}
          </span>
        )}
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight mb-4 text-white">
        {exam.data.fullName}
      </h1>
      
      <p class="text-lg md:text-xl text-slate-300 mb-8 max-w-3xl leading-relaxed">
        {exam.data.description}
      </p>

      <!-- Key Stats Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4 mb-8">
        {exam.data.keyStats.map((stat: any) => (
          <div class="bg-white/10 backdrop-blur-md rounded-xl p-4 border border-white/10 shadow-xs">
            <div class="text-teal-300 font-extrabold text-lg sm:text-xl">{stat.value}</div>
            <div class="text-xs sm:text-sm text-slate-300 font-medium">{stat.label}</div>
          </div>
        ))}
      </div>

      <!-- Quick Action CTAs -->
      <div class="flex flex-wrap items-center gap-3">
        {mockTests && mockTests.length > 0 ? (
          <a href="#mock-tests-hub" class="btn btn-primary inline-flex items-center gap-2">
            <span>🚀</span> Start Interactive Mock Tests
          </a>
        ) : (
          <a href="/mcqs" class="btn btn-primary inline-flex items-center gap-2">
            <span>🚀</span> Practice Subject MCQs
          </a>
        )}
        {syllabus && syllabus.length > 0 && (
          <a href="#official-syllabus" class="btn btn-secondary inline-flex items-center gap-2">
            <span>📋</span> View Official Syllabus Breakdown
          </a>
        )}
      </div>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      
      <!-- Main Content Column -->
      <div class="lg:col-span-2 space-y-10">
        
        <!-- Interactive Mock Tests Section -->
        {mockTests && mockTests.length > 0 && (
          <section id="mock-tests-hub" class="bg-white rounded-2xl p-6 sm:p-8 border border-teal-200 shadow-md">
            <div class="flex items-center justify-between pb-4 mb-6 border-b border-slate-100 flex-wrap gap-2">
              <div>
                <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-bold uppercase tracking-wider bg-teal-100 text-teal-800 mb-1">
                  Interactive Practice Hub
                </span>
                <h2 class="text-2xl font-black text-slate-900 tracking-tight">
                  Online Practice & Mock Tests
                </h2>
              </div>
              <span class="text-xs text-slate-500 font-medium">Timed Mode • Instant Scoring • Complete Solutions</span>
            </div>

            <div class="space-y-4">
              {mockTests.map((test: any, idx: number) => (
                <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 p-4 rounded-xl bg-slate-50 border border-slate-200 hover:border-teal-400 hover:bg-teal-50/30 transition-all">
                  <div class="space-y-1">
                    <div class="flex items-center gap-2">
                      <span class="w-6 h-6 rounded-full bg-teal-600 text-white text-xs font-bold flex items-center justify-center">
                        {idx + 1}
                      </span>
                      <h3 class="font-bold text-slate-900 hover:text-teal-700 transition">
                        <a href={`/mcqs/${test.subjectSlug}/${test.topicSlug}`}>
                          {test.title}
                        </a>
                      </h3>
                    </div>
                    <div class="flex items-center gap-3 text-xs text-slate-600 pl-8">
                      {test.questionsCount && (
                        <span>📝 {test.questionsCount} Questions</span>
                      )}
                      {test.duration && (
                        <span>⏱️ {test.duration}</span>
                      )}
                      <span class="capitalize">📚 {test.subjectSlug.replace('-', ' ')}</span>
                    </div>
                  </div>

                  <a
                    href={`/mcqs/${test.subjectSlug}/${test.topicSlug}`}
                    class="w-full sm:w-auto text-center px-4 py-2 rounded-lg bg-teal-600 hover:bg-teal-700 text-white font-bold text-xs uppercase tracking-wider transition-transform hover:scale-105 shadow-sm inline-flex items-center justify-center gap-1.5"
                  >
                    <span>Launch Test</span>
                    <span>→</span>
                  </a>
                </div>
              ))}
            </div>
          </section>
        )}

        <!-- Official Syllabus Breakdown Section -->
        {syllabus && syllabus.length > 0 && (
          <section id="official-syllabus" class="bg-white rounded-2xl p-6 sm:p-8 border border-slate-200 shadow-sm">
            <div class="pb-4 mb-6 border-b border-slate-100">
              <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-bold uppercase tracking-wider bg-slate-100 text-slate-700 mb-1">
                Official Commission Scheme
              </span>
              <h2 class="text-2xl font-black text-slate-900 tracking-tight">
                Syllabus & Marks Specification
              </h2>
            </div>

            <div class="space-y-6">
              {syllabus.map((part: any) => (
                <div class="border border-slate-200 rounded-xl p-5 bg-slate-50/60">
                  <div class="flex items-center justify-between mb-3 flex-wrap gap-2">
                    <span class="font-bold text-sm text-teal-800 bg-teal-100 px-3 py-1 rounded-md">
                      {part.part}
                    </span>
                    {part.marks && (
                      <span class="font-black text-xs text-slate-700 bg-white px-2.5 py-1 rounded-md border border-slate-200">
                        {part.marks}
                      </span>
                    )}
                  </div>

                  <h3 class="text-lg font-bold text-slate-900 mb-2">{part.title}</h3>
                  {part.description && (
                    <p class="text-sm text-slate-600 mb-4 leading-relaxed">{part.description}</p>
                  )}

                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 mb-4">
                    {part.topics.map((t: string) => (
                      <div class="flex items-start gap-2 text-xs text-slate-700 bg-white p-2.5 rounded-lg border border-slate-200/80">
                        <span class="text-teal-600 font-bold">✓</span>
                        <span class="leading-snug">{t}</span>
                      </div>
                    ))}
                  </div>

                  {part.practiceLink && (
                    <div class="pt-2">
                      <a
                        href={part.practiceLink}
                        class="text-teal-700 hover:text-teal-900 font-bold text-xs inline-flex items-center gap-1 group"
                      >
                        <span>Practice Questions for {part.part}</span>
                        <span class="group-hover:translate-x-1 transition-transform">→</span>
                      </a>
                    </div>
                  )}
                </div>
              ))}
            </div>
          </section>
        )}

        <!-- Markdown Article Body -->
        <article class="bg-white rounded-2xl p-6 sm:p-8 border border-slate-200 shadow-sm">
          <div class="prose prose-slate prose-teal max-w-none">
            <Content />
          </div>
        </article>

      </div>

      <!-- Right Sidebar Column -->
      <div class="space-y-6">
        
        <!-- Post Summary Card -->
        <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm">
          <h3 class="font-extrabold text-slate-900 text-base mb-4 pb-2 border-b border-slate-100 flex items-center gap-2">
            <span>ℹ️</span> Post Summary Specifications
          </h3>

          <dl class="space-y-3 text-xs sm:text-sm">
            <div>
              <dt class="text-slate-500 font-medium">Conducting Commission</dt>
              <dd class="text-slate-900 font-bold mt-0.5">{exam.data.conductingBody}</dd>
            </div>
            {caseNo && (
              <div>
                <dt class="text-slate-500 font-medium">Advertisement / Case No.</dt>
                <dd class="text-slate-900 font-bold mt-0.5">{caseNo}</dd>
              </div>
            )}
            {scale && (
              <div>
                <dt class="text-slate-500 font-medium">Basic Pay Scale</dt>
                <dd class="text-teal-700 font-bold mt-0.5">{scale}</dd>
              </div>
            )}
            <div>
              <dt class="text-slate-500 font-medium">Exam / Test Format</dt>
              <dd class="text-slate-900 font-medium mt-0.5 leading-relaxed">{exam.data.examFormat}</dd>
            </div>
            <div>
              <dt class="text-slate-500 font-medium">Minimum Eligibility</dt>
              <dd class="text-slate-700 text-xs mt-0.5 leading-relaxed bg-slate-50 p-2.5 rounded-lg border border-slate-100">
                {exam.data.eligibility}
              </dd>
            </div>
          </dl>
        </div>

        <!-- Featured Subject Modules -->
        {exam.data.featuredSubjects && exam.data.featuredSubjects.length > 0 && (
          <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm">
            <h3 class="font-extrabold text-slate-900 text-base mb-3 pb-2 border-b border-slate-100 flex items-center gap-2">
              <span>📚</span> Core Subject Domains
            </h3>
            <p class="text-xs text-slate-500 mb-3">
              Practice verified questions categorized by subject syllabus:
            </p>
            <div class="flex flex-wrap gap-1.5">
              {exam.data.featuredSubjects.map((subj: string) => (
                <span class="px-2.5 py-1 text-xs rounded-md bg-slate-100 text-slate-700 font-medium border border-slate-200">
                  {subj}
                </span>
              ))}
            </div>
            <div class="mt-4 pt-3 border-t border-slate-100">
              <a href="/subjects" class="text-teal-600 hover:text-teal-700 text-xs font-bold inline-flex items-center gap-1">
                Explore All 40+ Subjects & Topics →
              </a>
            </div>
          </div>
        )}

        <!-- Related Commission Posts -->
        {relatedExams && relatedExams.length > 0 && (
          <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm">
            <h3 class="font-extrabold text-slate-900 text-base mb-4 pb-2 border-b border-slate-100 flex items-center gap-2">
              <span>🎯</span> Other Advertised Posts
            </h3>
            <div class="space-y-3">
              {relatedExams.map((rel: any) => (
                <a
                  href={`/exams/${rel.slug}`}
                  class="block p-3 rounded-xl bg-slate-50 hover:bg-teal-50 border border-slate-200 hover:border-teal-300 transition group"
                >
                  <div class="text-xs font-bold text-teal-700 mb-0.5">
                    {rel.data.scale ? `${rel.data.scale} • ` : ''}{rel.data.commission || 'Recruitment'}
                  </div>
                  <h4 class="text-sm font-bold text-slate-900 group-hover:text-teal-600 transition leading-snug line-clamp-1">
                    {rel.data.title}
                  </h4>
                  <p class="text-[11px] text-slate-500 line-clamp-1 mt-1">
                    {rel.data.fullName}
                  </p>
                </a>
              ))}
            </div>
            <div class="mt-4 pt-3 border-t border-slate-100">
              <a href="/jobs" class="text-teal-600 hover:text-teal-700 text-xs font-bold inline-flex items-center gap-1">
                Browse All Government Posts & Screening Tests →
              </a>
            </div>
          </div>
        )}

      </div>

    </div>
  </div>
</BaseLayout>
