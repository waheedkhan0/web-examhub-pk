---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const subjects = await getCollection('subjects');
const sortedSubjects = subjects.sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<BaseLayout
  title="Admin MCQ CSV Importer | ExamHub.pk"
  description="Bulk import MCQs through CSV files with instant validation, live preview, de-duplication, and automatic collection updating."
  noindex={true}
  showAds={false}
>
  <div class="bg-gradient-to-br from-slate-900 via-slate-800 to-teal-950 text-white py-12">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-teal-500/20 border border-teal-400/30 text-teal-300 text-sm font-medium mb-3">
        <span>⚡</span> Content Management System Tool
      </div>
      <h1 class="text-3xl md:text-4xl font-bold mb-3">MCQ CSV Importer & Validator</h1>
      <p class="text-lg text-slate-300 max-w-3xl">
        Upload or paste multiple-choice questions from CSV files. Preview questions in real-time, validate answer keys and explanations, and import directly into the website's content collections.
      </p>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Controls & Config Card -->
    <div class="bg-white rounded-xl border border-slate-200 p-6 md:p-8 shadow-sm mb-8">
      <h2 class="text-xl font-bold text-slate-900 mb-6 flex items-center justify-between">
        <span>1. Target Destination & File Upload</span>
        <button
          type="button"
          id="download-template-btn"
          class="text-sm font-medium text-teal-600 hover:text-teal-700 bg-teal-50 px-3 py-1.5 rounded-lg border border-teal-200 transition"
        >
          📥 Download Sample CSV Template
        </button>
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-2">Subject / Category</label>
          <select id="subject-select" class="w-full border border-slate-300 rounded-lg p-2.5 text-slate-800 focus:ring-2 focus:ring-teal-500">
            <option value="">-- Auto-detect from CSV or Select --</option>
            {sortedSubjects.map((sub) => (
              <option value={sub.slug}>{sub.data.title} ({sub.slug})</option>
            ))}
          </select>
          <p class="text-xs text-slate-500 mt-1">If empty, will read the 'Subject' column from the CSV.</p>
        </div>

        <div>
          <label class="block text-sm font-medium text-slate-700 mb-2">Topic Slug</label>
          <input
            type="text"
            id="topic-input"
            placeholder="e.g. constitution-part-1, optics-advanced"
            class="w-full border border-slate-300 rounded-lg p-2.5 text-slate-800 focus:ring-2 focus:ring-teal-500"
          />
          <p class="text-xs text-slate-500 mt-1">Slug name for the file in src/content/mcqs/&lt;subject&gt;/&lt;topic&gt;.md</p>
        </div>
      </div>

      <!-- Drag & Drop Zone -->
      <div
        id="drop-zone"
        class="border-2 border-dashed border-slate-300 hover:border-teal-500 rounded-xl p-8 text-center bg-slate-50 hover:bg-teal-50/30 transition cursor-pointer mb-6"
      >
        <div class="w-12 h-12 mx-auto mb-3 text-slate-400">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-full h-full">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
          </svg>
        </div>
        <div class="text-base font-semibold text-slate-800 mb-1">
          Drag & drop your CSV file here, or <span class="text-teal-600 underline">browse</span>
        </div>
        <p class="text-sm text-slate-500 mb-3">Supports .csv with headers: question, option1, option2, option3, option4, answer, explanation</p>
        <input type="file" id="file-input" accept=".csv,text/csv" class="hidden" />
      </div>

      <!-- Paste CSV Alternative -->
      <div>
        <details class="group">
          <summary class="text-sm font-semibold text-slate-700 cursor-pointer hover:text-teal-600 flex items-center gap-1">
            <span>Or paste raw CSV text directly</span>
            <span class="group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <div class="mt-3">
            <textarea
              id="raw-csv-textarea"
              rows="6"
              placeholder="question,option1,option2,option3,option4,answer,explanation&#10;&quot;Who was the first Governor General of Pakistan?&quot;,&quot;Liaquat Ali Khan&quot;,&quot;Quaid-e-Azam Muhammad Ali Jinnah&quot;,&quot;Khawaja Nazimuddin&quot;,&quot;Ghulam Muhammad&quot;,&quot;2&quot;,&quot;Quaid-e-Azam took oath on 15 August 1947.&quot;"
              class="w-full font-mono text-xs border border-slate-300 rounded-lg p-3 text-slate-800 focus:ring-2 focus:ring-teal-500"
            ></textarea>
            <button
              type="button"
              id="parse-raw-btn"
              class="mt-2 btn btn-secondary text-sm"
            >
              Parse Text
            </button>
          </div>
        </details>
      </div>
    </div>

    <!-- Live Preview & Import Actions -->
    <div id="preview-section" class="hidden bg-white rounded-xl border border-slate-200 p-6 md:p-8 shadow-sm">
      <div class="flex flex-col md:flex-row justify-between items-start md:items-center pb-6 mb-6 border-b border-slate-200 gap-4">
        <div>
          <h2 class="text-xl font-bold text-slate-900">2. Parsed MCQs Preview (<span id="parsed-count">0</span> questions)</h2>
          <p class="text-sm text-slate-500">Review the parsed questions before writing them into the content collection.</p>
        </div>

        <div class="flex items-center gap-3">
          <button
            type="button"
            id="clear-btn"
            class="px-4 py-2 text-sm font-semibold text-slate-600 hover:text-slate-800 bg-slate-100 hover:bg-slate-200 rounded-lg transition"
          >
            Clear
          </button>
          <button
            type="button"
            id="commit-import-btn"
            class="btn btn-primary text-sm flex items-center gap-2"
          >
            <span>🚀</span> Import to Collection
          </button>
        </div>
      </div>

      <!-- Import Progress / Message Alert -->
      <div id="status-alert" class="hidden mb-6 p-4 rounded-lg text-sm"></div>

      <!-- Questions Table -->
      <div class="overflow-x-auto max-h-[600px] overflow-y-auto border border-slate-200 rounded-lg">
        <table class="w-full text-left text-sm text-slate-700">
          <thead class="bg-slate-100 text-xs font-bold text-slate-800 uppercase tracking-wider sticky top-0 border-b border-slate-200">
            <tr>
              <th class="p-3 w-12 text-center">#</th>
              <th class="p-3 min-w-[280px]">Question</th>
              <th class="p-3 min-w-[240px]">Options</th>
              <th class="p-3 w-28 text-center">Answer Key</th>
              <th class="p-3 min-w-[240px]">Explanation</th>
            </tr>
          </thead>
          <tbody id="preview-tbody" class="divide-y divide-slate-200">
            <!-- Dynamically populated -->
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <script>
    let parsedItems = [];
    let currentRawCsv = '';

    const dropZone = document.getElementById('drop-zone');
    const fileInput = document.getElementById('file-input');
    const rawTextarea = document.getElementById('raw-csv-textarea');
    const parseRawBtn = document.getElementById('parse-raw-btn');
    const previewSection = document.getElementById('preview-section');
    const previewTbody = document.getElementById('preview-tbody');
    const parsedCountSpan = document.getElementById('parsed-count');
    const commitImportBtn = document.getElementById('commit-import-btn');
    const clearBtn = document.getElementById('clear-btn');
    const statusAlert = document.getElementById('status-alert');
    const subjectSelect = document.getElementById('subject-select');
    const topicInput = document.getElementById('topic-input');
    const downloadTemplateBtn = document.getElementById('download-template-btn');

    // RFC-4180 CSV parser for browser
    function parseCsvInBrowser(text) {
      const lines = [];
      let row = [''];
      let inQuotes = false;
      let i = 0;

      while (i < text.length) {
        const char = text[i];
        const next = text[i + 1];

        if (inQuotes) {
          if (char === '"' && next === '"') {
            row[row.length - 1] += '"';
            i += 2;
            continue;
          }
          if (char === '"') {
            inQuotes = false;
            i++;
            continue;
          }
          row[row.length - 1] += char;
          i++;
          continue;
        }

        if (char === '"') {
          inQuotes = true;
          i++;
          continue;
        }

        if (char === ',') {
          row.push('');
          i++;
          continue;
        }

        if (char === '\r' && next === '\n') {
          lines.push(row);
          row = [''];
          i += 2;
          continue;
        }

        if (char === '\n' || char === '\r') {
          lines.push(row);
          row = [''];
          i++;
          continue;
        }

        row[row.length - 1] += char;
        i++;
      }

      if (row.length > 1 || row[0] !== '') {
        lines.push(row);
      }

      if (lines.length === 0) return [];

      const headers = lines[0].map(h => h.replace(/^\uFEFF/, '').trim().toLowerCase().replace(/[^a-z0-9]/g, ''));
      const records = [];

      for (let r = 1; r < lines.length; r++) {
        const cells = lines[r];
        if (cells.length === 1 && cells[0].trim() === '') continue;
        const item = {};
        headers.forEach((h, idx) => {
          item[h] = (cells[idx] || '').trim();
        });
        records.push(item);
      }

      return records;
    }

    function processRecords(records) {
      parsedItems = [];
      records.forEach((row, idx) => {
        const question = row.question || row.questiontext || row.stem || row.mcq || row.q || '';
        if (!question) return;

        let options = [];
        if (row.option1 || row.option2) {
          options = [row.option1, row.option2, row.option3, row.option4, row.option5].filter(Boolean);
        } else if (row.a || row.b) {
          options = [row.a, row.b, row.c, row.d, row.e].filter(Boolean);
        } else if (row.options) {
          options = row.options.split('|').map(s => s.trim()).filter(Boolean);
        }

        const answer = row.answer || row.correctanswer || row.correct || row.ans || row.correctoption || '1';
        const explanation = row.explanation || row.explanationtext || row.reason || row.rationale || 'Detailed worked solution.';

        parsedItems.push({
          id: idx + 1,
          question,
          options,
          answer,
          explanation,
          subject: row.subject || row.category || '',
          topic: row.topic || row.topicslug || '',
        });
      });

      renderPreview();
    }

    function renderPreview() {
      if (parsedItems.length === 0) {
        previewSection.classList.add('hidden');
        return;
      }

      previewSection.classList.remove('hidden');
      parsedCountSpan.textContent = parsedItems.length;
      previewTbody.innerHTML = '';

      parsedItems.slice(0, 100).forEach((item, idx) => {
        const tr = document.createElement('tr');
        tr.className = idx % 2 === 0 ? 'bg-white' : 'bg-slate-50/50';

        const optHtml = item.options.map((opt, oIdx) => {
          return `<div class="text-xs text-slate-600"><strong class="text-slate-800">${String.fromCharCode(65 + oIdx)}:</strong> ${escapeHtml(opt)}</div>`;
        }).join('');

        tr.innerHTML = `
          <td class="p-3 text-center text-xs font-semibold text-slate-500">${idx + 1}</td>
          <td class="p-3 text-sm font-medium text-slate-900">${escapeHtml(item.question)}</td>
          <td class="p-3 space-y-1">${optHtml}</td>
          <td class="p-3 text-center">
            <span class="inline-block px-2 py-1 text-xs font-bold rounded bg-teal-100 text-teal-800">${escapeHtml(item.answer)}</span>
          </td>
          <td class="p-3 text-xs text-slate-600 line-clamp-3">${escapeHtml(item.explanation)}</td>
        `;
        previewTbody.appendChild(tr);
      });

      // Auto-populate subject or topic if detected
      if (parsedItems[0]?.subject && !subjectSelect.value) {
        subjectSelect.value = parsedItems[0].subject.toLowerCase().replace(/[^a-z0-9]+/g, '-');
      }
      if (parsedItems[0]?.topic && !topicInput.value) {
        topicInput.value = parsedItems[0].topic.toLowerCase().replace(/[^a-z0-9]+/g, '-');
      }
    }

    function escapeHtml(str) {
      return String(str ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    // Drag and Drop handlers
    dropZone.addEventListener('click', () => fileInput.click());
    dropZone.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropZone.classList.add('border-teal-500', 'bg-teal-50/50');
    });
    dropZone.addEventListener('dragleave', () => {
      dropZone.classList.remove('border-teal-500', 'bg-teal-50/50');
    });
    dropZone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropZone.classList.remove('border-teal-500', 'bg-teal-50/50');
      if (e.dataTransfer.files.length > 0) {
        handleFile(e.dataTransfer.files[0]);
      }
    });

    fileInput.addEventListener('change', () => {
      if (fileInput.files.length > 0) {
        handleFile(fileInput.files[0]);
      }
    });

    function handleFile(file) {
      const reader = new FileReader();
      reader.onload = (e) => {
        currentRawCsv = e.target.result;
        const records = parseCsvInBrowser(currentRawCsv);
        processRecords(records);
      };
      reader.readAsText(file);
    }

    parseRawBtn.addEventListener('click', () => {
      currentRawCsv = rawTextarea.value.trim();
      if (!currentRawCsv) return;
      const records = parseCsvInBrowser(currentRawCsv);
      processRecords(records);
    });

    clearBtn.addEventListener('click', () => {
      parsedItems = [];
      currentRawCsv = '';
      rawTextarea.value = '';
      fileInput.value = '';
      renderPreview();
      statusAlert.classList.add('hidden');
    });

    // Commit import to API
    commitImportBtn.addEventListener('click', async () => {
      const subject = subjectSelect.value.trim();
      const topic = topicInput.value.trim();

      if (!subject) {
        alert('Please select or specify a Subject.');
        subjectSelect.focus();
        return;
      }
      if (!topic) {
        alert('Please specify a Topic slug (e.g. general-geography-part-1).');
        topicInput.focus();
        return;
      }

      commitImportBtn.disabled = true;
      commitImportBtn.textContent = 'Importing...';

      statusAlert.className = 'p-4 rounded-lg text-sm bg-blue-50 text-blue-800 border border-blue-200 block mb-6';
      statusAlert.textContent = 'Submitting MCQs to API endpoint...';

      try {
        const res = await fetch('/api/import-mcqs', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            subject,
            topic,
            csvText: currentRawCsv,
            items: parsedItems,
          }),
        });

        const data = await res.json();

        if (res.ok && data.success) {
          statusAlert.className = 'p-4 rounded-lg text-sm bg-green-50 text-green-800 border border-green-200 block mb-6';
          statusAlert.innerHTML = `
            <strong>Success!</strong> ${data.message}.<br>
            • Added: ${data.addedCount} new MCQs<br>
            • Duplicates skipped: ${data.duplicateCount}<br>
            • Total in file: ${data.totalInFile}<br>
            <a href="/mcqs/${data.subject}/${data.topic}" class="underline font-bold mt-2 inline-block text-green-900" target="_blank">View Live Topic Page →</a>
          `;
        } else {
          statusAlert.className = 'p-4 rounded-lg text-sm bg-red-50 text-red-800 border border-red-200 block mb-6';
          statusAlert.textContent = `Import Failed: ${data.error || 'Unknown error'}`;
        }
      } catch (err) {
        statusAlert.className = 'p-4 rounded-lg text-sm bg-red-50 text-red-800 border border-red-200 block mb-6';
        statusAlert.textContent = `Network / Server Error: ${err.message}`;
      } finally {
        commitImportBtn.disabled = false;
        commitImportBtn.innerHTML = '<span>🚀</span> Import to Collection';
      }
    });

    // Download sample template
    downloadTemplateBtn.addEventListener('click', () => {
      const sample = `question,option1,option2,option3,option4,answer,explanation,keyConcept,examTip
"Under which section of FIA Act 1974 is the Agency constituted?","Section 3","Section 5","Section 7","Section 12","1","Section 3 of the FIA Act 1974 empowers the Federal Government to constitute the Federal Investigation Agency.","FIA Statutory Constitution","Important for FPSC Assistant Director FIA"
"What is the standard weightage of English in FPSC screening tests?","10%","20%","30%","50%","2","Part-I of standard FPSC screening test comprises 20 Marks dedicated to English Grammar & Vocabulary.","FPSC General Scheme","Focus on prepositions and active/passive voice"
"Which organelle is known as the powerhouse of eukaryotic cells?","Ribosome","Golgi Apparatus","Mitochondria","Endoplasmic Reticulum","3","Mitochondria generate most of the chemical energy needed to power the cell biochemical reactions (ATP).","Cell Biology Fundamentals","Tested in FPSC & KPPSC Lecturer Biology"
`;
      const blob = new Blob([sample], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'examhub_mcq_template.csv';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    });
  </script>
</BaseLayout>
