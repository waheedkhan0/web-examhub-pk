---
interface Question {
  id: number;
  question: string;
  options: string[];
  answer: number;
  explanation: string;
  keyConcept?: string;
  examTip?: string;
  testedIn?: string[];
}

interface Props {
  questions: Question[];
  subjectTitle: string;
  topicTitle: string;
}

const { questions, subjectTitle, topicTitle } = Astro.props;
---

<div class="space-y-8" id="mcq-interactive-container">
  <!-- Progress & Filter bar -->
  <div class="bg-white rounded-xl p-4 sm:p-5 border border-slate-200 shadow-xs flex flex-wrap items-center justify-between gap-4">
    <div class="flex items-center gap-3">
      <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-teal-100 text-teal-800 font-bold text-sm">
        {questions.length}
      </span>
      <div>
        <p class="text-sm font-semibold text-slate-800">Total Practice MCQs</p>
        <p class="text-xs text-slate-500">Instant feedback with detailed pedagogical explanations</p>
      </div>
    </div>
    <div class="flex items-center gap-2">
      <button 
        id="reveal-all-btn"
        class="text-xs font-semibold px-3 py-1.5 rounded-lg border border-slate-300 text-slate-700 hover:bg-slate-50 transition-colors"
      >
        Reveal All Answers
      </button>
      <button 
        id="reset-all-btn"
        class="text-xs font-semibold px-3 py-1.5 rounded-lg border border-slate-300 text-slate-700 hover:bg-slate-50 transition-colors"
      >
        Reset Progress
      </button>
    </div>
  </div>

  <!-- Questions List -->
  <div class="space-y-6">
    {questions.map((q, idx) => (
      <article 
        id={`question-${q.id}`} 
        class="mcq-card bg-white rounded-2xl border border-slate-200 p-5 sm:p-7 shadow-xs hover:border-teal-200 transition-all"
        data-qid={q.id}
        data-correct={q.answer}
      >
        <!-- Header: Question number & past paper tag -->
        <div class="flex items-start justify-between gap-4 mb-4">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-slate-100 text-slate-700">
            Q{idx + 1} of {questions.length}
          </span>
          {q.testedIn && q.testedIn.length > 0 && (
            <div class="flex flex-wrap gap-1 justify-end">
              {q.testedIn.map((tag) => (
                <span class="text-[11px] font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200 px-2 py-0.5 rounded-md">
                  ★ {tag}
                </span>
              ))}
            </div>
          )}
        </div>

        <!-- Question Title -->
        <h3 class="text-base sm:text-lg font-bold text-slate-900 leading-snug mb-5">
          {q.question}
        </h3>

        <!-- Options Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-5">
          {q.options.map((option, optIdx) => {
            const letter = String.fromCharCode(65 + optIdx);
            return (
              <button
                type="button"
                class="opt-btn w-full text-left p-3.5 rounded-xl border border-slate-200 hover:bg-slate-50 hover:border-teal-400 transition-all flex items-start gap-3 group focus:outline-hidden focus:ring-2 focus:ring-teal-500/20"
                data-option-index={optIdx}
              >
                <span class="opt-badge flex-shrink-0 w-6 h-6 rounded-full border border-slate-300 text-slate-600 font-bold text-xs flex items-center justify-center group-hover:border-teal-500 group-hover:text-teal-600 transition-colors">
                  {letter}
                </span>
                <span class="opt-text text-sm font-medium text-slate-700 leading-relaxed">
                  {option}
                </span>
              </button>
            );
          })}
        </div>

        <!-- Toggle Explanation Button -->
        <div class="pt-2 flex items-center justify-between border-t border-slate-100">
          <button 
            type="button" 
            class="toggle-exp-btn text-xs font-semibold text-teal-700 hover:text-teal-900 flex items-center gap-1"
          >
            <span>Show Explanation</span>
            <svg class="w-4 h-4 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <span class="result-badge text-xs font-bold hidden"></span>
        </div>

        <!-- Deep Explanation Box (Critical for AdSense & Educational Depth) -->
        <div class="exp-box mt-4 hidden rounded-xl bg-slate-50 border border-slate-200 p-4 sm:p-5 space-y-3">
          <div class="flex items-center gap-2 text-teal-800 font-bold text-sm">
            <svg class="w-5 h-5 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <span>Correct Answer: Option {String.fromCharCode(65 + q.answer)} — {q.options[q.answer]}</span>
          </div>

          <div class="text-sm text-slate-700 leading-relaxed border-t border-slate-200/60 pt-3">
            <strong class="text-slate-900 block mb-1">Detailed Academic Explanation:</strong>
            <p>{q.explanation}</p>
          </div>

          {q.keyConcept && (
            <div class="bg-amber-50/70 border border-amber-200/80 rounded-lg p-3 text-xs text-amber-900">
              <strong class="font-bold flex items-center gap-1 mb-0.5">
                💡 Key Conceptual Anchor:
              </strong>
              <span>{q.keyConcept}</span>
            </div>
          )}

          {q.examTip && (
            <div class="bg-blue-50/70 border border-blue-200/80 rounded-lg p-3 text-xs text-blue-900">
              <strong class="font-bold flex items-center gap-1 mb-0.5">
                🎯 Examiner's Trap & Study Tip:
              </strong>
              <span>{q.examTip}</span>
            </div>
          )}
        </div>
      </article>
    ))}
  </div>
</div>

<script>
  function setupInteractiveMCQs() {
    const cards = document.querySelectorAll('.mcq-card');

    cards.forEach((card) => {
      const correctIndex = parseInt(card.getAttribute('data-correct') || '0', 10);
      const buttons = card.querySelectorAll<HTMLButtonElement>('.opt-btn');
      const toggleExpBtn = card.querySelector<HTMLButtonElement>('.toggle-exp-btn');
      const expBox = card.querySelector<HTMLDivElement>('.exp-box');
      const resultBadge = card.querySelector<HTMLSpanElement>('.result-badge');

      function showExplanation() {
        if (!expBox) return;
        expBox.classList.remove('hidden');
        if (toggleExpBtn) {
          toggleExpBtn.querySelector('span')!.textContent = 'Hide Explanation';
          toggleExpBtn.querySelector('svg')!.classList.add('rotate-180');
        }
      }

      function hideExplanation() {
        if (!expBox) return;
        expBox.classList.add('hidden');
        if (toggleExpBtn) {
          toggleExpBtn.querySelector('span')!.textContent = 'Show Explanation';
          toggleExpBtn.querySelector('svg')!.classList.remove('rotate-180');
        }
      }

      toggleExpBtn?.addEventListener('click', () => {
        if (expBox?.classList.contains('hidden')) {
          showExplanation();
        } else {
          hideExplanation();
        }
      });

      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const selectedIdx = parseInt(btn.getAttribute('data-option-index') || '0', 10);
          
          // Disable further clicking on this card options
          buttons.forEach((b) => b.classList.add('pointer-events-none'));

          if (selectedIdx === correctIndex) {
            btn.classList.add('bg-emerald-50', 'border-emerald-500', 'text-emerald-900');
            const badge = btn.querySelector('.opt-badge');
            badge?.classList.add('bg-emerald-600', 'text-white', 'border-emerald-600');
            if (resultBadge) {
              resultBadge.textContent = '✓ Correct Answer';
              resultBadge.className = 'result-badge text-xs font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded';
              resultBadge.classList.remove('hidden');
            }
          } else {
            btn.classList.add('bg-rose-50', 'border-rose-400', 'text-rose-900');
            const badge = btn.querySelector('.opt-badge');
            badge?.classList.add('bg-rose-600', 'text-white', 'border-rose-600');
            
            // Highlight correct one
            const correctBtn = buttons[correctIndex];
            correctBtn?.classList.add('bg-emerald-50', 'border-emerald-500');
            const correctBadge = correctBtn?.querySelector('.opt-badge');
            correctBadge?.classList.add('bg-emerald-600', 'text-white', 'border-emerald-600');

            if (resultBadge) {
              resultBadge.textContent = '✗ Incorrect';
              resultBadge.className = 'result-badge text-xs font-bold text-rose-700 bg-rose-50 px-2 py-0.5 rounded';
              resultBadge.classList.remove('hidden');
            }
          }

          showExplanation();
        });
      });
    });

    // Bulk buttons
    document.getElementById('reveal-all-btn')?.addEventListener('click', () => {
      document.querySelectorAll('.exp-box').forEach((box) => box.classList.remove('hidden'));
      document.querySelectorAll('.toggle-exp-btn').forEach((btn) => {
        btn.querySelector('span')!.textContent = 'Hide Explanation';
        btn.querySelector('svg')?.classList.add('rotate-180');
      });
    });

    document.getElementById('reset-all-btn')?.addEventListener('click', () => {
      window.location.reload();
    });
  }

  // Initialize
  setupInteractiveMCQs();
  document.addEventListener('astro:after-swap', setupInteractiveMCQs);
</script>
