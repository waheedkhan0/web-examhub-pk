---
interface Props {
  title?: string;
  placeholder?: string;
  /** "dropdown" floats results under the box; "list" renders results inline below it. */
  variant?: 'dropdown' | 'list';
  /** Pre-filled query, used by /search?q=… */
  initialQuery?: string;
}

const {
  title = 'Search MCQs, Subjects & Guides',
  placeholder = 'Search subjects, topics, MCQs (e.g., Pakistan Studies, Quran, Rivers, CSS…)',
  variant = 'dropdown',
  initialQuery = '',
} = Astro.props;
---

<div
  class="relative w-full max-w-2xl mx-auto my-6"
  id="search-widget"
  data-variant={variant}
  data-index-url="/search-index.json"
  data-initial-query={initialQuery}
>
  <div class="relative">
    <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
    </div>
    <label for="site-search-input" class="sr-only">{title}</label>
    <input
      type="search"
      id="site-search-input"
      name="q"
      autocomplete="off"
      aria-describedby="search-status"
      value={initialQuery}
      placeholder={placeholder}
      class="w-full pl-11 pr-4 py-3 bg-white border border-slate-300 rounded-xl text-sm placeholder-slate-400 focus:outline-hidden focus:ring-2 focus:ring-teal-500 focus:border-teal-500 shadow-xs transition-all"
    />
  </div>

  <p id="search-status" class="sr-only" aria-live="polite"></p>

  <div
    id="search-results"
    class:list={[
      'mt-2 bg-white rounded-xl border border-slate-200 z-50 overflow-hidden',
      variant === 'dropdown'
        ? 'hidden absolute top-full left-0 right-0 shadow-xl max-h-96 overflow-y-auto divide-y divide-slate-100'
        : 'divide-y divide-slate-100',
    ]}
  ></div>
</div>

<script>
  interface SearchEntry {
    title: string;
    url: string;
    category: string;
    description: string;
    keywords: string;
  }

  const BADGE: Record<string, string> = {
    Exam: 'bg-purple-100 text-purple-800',
    Guide: 'bg-amber-100 text-amber-800',
    Blog: 'bg-sky-100 text-sky-800',
    Subject: 'bg-slate-100 text-slate-700',
    'MCQ Set': 'bg-teal-100 text-teal-800',
  };

  /** Content is author-controlled but still rendered as HTML — escape it anyway. */
  function esc(value: string): string {
    return String(value).replace(
      /[&<>"']/g,
      (c) => (({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }) as Record<string, string>)[c],
    );
  }

  function setupSearch() {
    const widget = document.getElementById('search-widget');
    const input = document.getElementById('site-search-input') as HTMLInputElement | null;
    const resultsBox = document.getElementById('search-results');
    const status = document.getElementById('search-status');
    if (!widget || !input || !resultsBox) return;

    const isDropdown = widget.dataset.variant === 'dropdown';
    const indexUrl = widget.dataset.indexUrl || '/search-index.json';
    const maxResults = isDropdown ? 7 : 40;

    let index: SearchEntry[] | null = null;
    let loading: Promise<SearchEntry[]> | null = null;

    function loadIndex(): Promise<SearchEntry[]> {
      if (index) return Promise.resolve(index);
      if (!loading) {
        loading = fetch(indexUrl)
          .then((r) => (r.ok ? r.json() : []))
          .then((data: SearchEntry[]) => {
            index = Array.isArray(data) ? data : [];
            return index;
          })
          .catch(() => {
            index = [];
            return index;
          });
      }
      return loading;
    }

    /** Exact phrase beats loose word matches, so "Pakistan Studies" outranks a stray "study". */
    function score(entry: SearchEntry, query: string): number {
      const title = entry.title.toLowerCase();
      const hay = `${title} ${entry.keywords} ${entry.description.toLowerCase()}`;
      let s = 0;
      if (title.includes(query)) s += 60;
      if (title.startsWith(query)) s += 25;
      if (hay.includes(query)) s += 20;
      for (const word of query.split(' ').filter((w) => w.length >= 2)) {
        if (title.includes(word)) s += 12;
        if (entry.keywords.includes(word)) s += 6;
      }
      if (entry.category.toLowerCase().includes(query)) s += 8;
      return s;
    }

    function renderEmpty() {
      resultsBox!.innerHTML = '';
      if (isDropdown) resultsBox!.classList.add('hidden');
      if (status) status.textContent = '';
    }

    function render(query: string, matches: SearchEntry[]) {
      if (!query) {
        renderEmpty();
        return;
      }

      if (matches.length === 0) {
        resultsBox!.innerHTML = `
          <div class="p-5 text-center text-sm text-slate-500">
            No results for “${esc(query)}”. Try a subject (“Islamiat”), an exam (“PPSC”) or a topic (“rivers”).
          </div>`;
        resultsBox!.classList.remove('hidden');
        if (status) status.textContent = 'No results found';
        return;
      }

      resultsBox!.innerHTML = matches
        .map(
          (m) => `
        <a href="${esc(m.url)}" class="block p-3.5 hover:bg-slate-50 transition-colors">
          <div class="flex items-center justify-between gap-3">
            <span class="text-xs font-bold px-2 py-0.5 rounded ${BADGE[m.category] || 'bg-slate-100 text-slate-700'}">${esc(m.category)}</span>
            <span class="text-xs text-slate-400 shrink-0">Open →</span>
          </div>
          <div class="text-sm font-semibold text-slate-800 mt-1.5">${esc(m.title)}</div>
          ${m.description ? `<div class="text-xs text-slate-500 mt-0.5 line-clamp-2">${esc(m.description).slice(0, 160)}</div>` : ''}
        </a>`,
        )
        .join('');
      resultsBox!.classList.remove('hidden');
      if (status) status.textContent = `${matches.length} result${matches.length === 1 ? '' : 's'}`;
    }

    async function run(query: string) {
      const q = query.trim().toLowerCase();
      if (q.length < 2) {
        renderEmpty();
        return;
      }
      const data = await loadIndex();
      const ranked = data
        .map((entry) => ({ entry, s: score(entry, q) }))
        .filter((r) => r.s > 0)
        .sort((a, b) => b.s - a.s || a.entry.title.length - b.entry.title.length)
        .slice(0, maxResults)
        .map((r) => r.entry);
      render(q, ranked);
    }

    function syncUrl(query: string) {
      const url = new URL(window.location.href);
      const value = query.trim();
      if (value) url.searchParams.set('q', value);
      else url.searchParams.delete('q');
      window.history.replaceState({}, '', url);
    }

    input.addEventListener('input', () => {
      run(input.value);
      if (isDropdown) syncUrl(input.value);
    });

    input.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter') return;
      e.preventDefault();
      run(input.value);
      syncUrl(input.value);
    });

    document.addEventListener('click', (e) => {
      if (!isDropdown) return;
      if (!widget!.contains(e.target as Node)) resultsBox!.classList.add('hidden');
    });

    const initial = (input.value || widget.dataset.initialQuery || '').trim();
    if (initial.length >= 2) run(initial);
  }

  setupSearch();
  document.addEventListener('astro:after-swap', setupSearch);
</script>
